<div class="scan-box" id="lecturasCarrito">
    <label class="scan-label">Escaneo directo al detalle</label>
    <div class="scan-row">
        <input data-codigo class="form-control scan-input" autocomplete="off" aria-label="Código de producto" placeholder="Escanee y pulse Enter" />
        <button data-agregar type="button" class="btn scan-btn scan-btn-read">Leer</button>
        <button data-deshacer type="button" class="btn scan-btn scan-btn-undo">Deshacer lectura</button>
    </div>
    <small class="scan-help" data-mensaje role="status" aria-live="polite">Cada lectura suma una unidad. El inventario cambia al confirmar.</small>
</div>
