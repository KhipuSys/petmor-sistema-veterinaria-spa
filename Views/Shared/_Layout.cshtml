        .main-content .table .text-end { text-align: right !important; }
        .main-content .table .text-center { text-align: center !important; }
        .table-hover tbody tr:hover { background: #fff7ed; }
        .table-responsive { border-radius: 14px; }
        .badge { border-radius: 999px; padding: 8px 12px; font-weight: 800; }
        .badge.bg-success { background: #dcfce7 !important; color: #059669 !important; }
        .badge.bg-danger { background: #fee2e2 !important; color: #dc2626 !important; }
        .badge.bg-secondary { background: #f1f5f9 !important; color: #334155 !important; }
        .badge.bg-primary,
        .badge.bg-info,
        .badge.bg-warning { background: #fff3ea !important; color: #f06800 !important; }

        .alert {
            border-radius: 14px;
            border: 1px solid #e5e7eb;
            background: #fff;
            color: #334155;
        }
        .alert-info { background: #fff7ed; border-color: #fed7aa; color: #9a3412; }
        .alert-warning { background: #fffbeb; border-color: #fde68a; color: #92400e; }
        .alert-danger { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
        .validation-summary-valid,
        .alert.validation-summary-valid,
        .alert[data-valmsg-summary="true"]:not(.validation-summary-errors) {
            display: none !important;
        }
        .validation-summary-errors, .field-validation-error { display: none !important; }

        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dataTables_length select {
            border-radius: 10px;
            border: 1px solid #cbd5e1;
            min-height: 40px;
        }
        .dataTables_wrapper .dataTables_length label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #475569;
            font-weight: 800;
        }
        .dataTables_wrapper .dataTables_length select {
            width: 74px !important;
            padding: 6px 28px 6px 10px;
            color: #0f172a;
            font-weight: 900;
        }
        .dt-buttons .btn { border-radius: 10px !important; }

        .date-filter-panel { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .date-filter-control { position: relative; }
        .date-filter-control i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #64748b; pointer-events: none; }
        .date-filter-control input { min-height: 42px; border: 1px solid #dbe3ee; border-radius: 10px; padding: 8px 12px 8px 38px; color: #334155; font-weight: 800; background: #fff; }
        .date-filter-apply, .date-filter-clear { min-height: 42px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; border-radius: 10px; padding: 8px 13px; font-weight: 900; }
        .date-filter-apply { background: #f06800; border: 1px solid #f06800; color: #fff !important; }
        .date-filter-apply:hover { background: #d95f00; color: #fff !important; }
        .date-filter-clear { background: #fff; border: 1px solid #fed7aa; color: #f06800 !important; }
        .date-filter-clear:hover { background: #fff7ed; color: #c2410c !important; }
        .dashboard-agenda-head .date-filter-apply span, .dashboard-agenda-head .date-filter-clear span { display: none; }
        .dashboard-agenda-head .date-filter-apply, .dashboard-agenda-head .date-filter-clear { width: 42px; padding: 8px; }
        @@media (max-width: 767.98px) { .date-filter-panel, .date-filter-control, .date-filter-control input { width: 100%; } .date-filter-apply, .date-filter-clear { flex: 1 1 0; } }
        @@media (max-width: 575.98px) { .scan-row { grid-template-columns: 1fr; } .scan-btn { width: 100%; } }

        .petmor-page-title,
        .d-flex.justify-content-between.align-items-center.mb-4,
        .d-flex.justify-content-between.mb-4 {
            border: 1px solid #e5e7eb;
            border-radius: 22px;
            background: #fff;
            padding: 24px 28px;
        }
        .d-flex.justify-content-between.align-items-center.mb-4 h2,
        .d-flex.justify-content-between.align-items-center.mb-4 h3,
        .d-flex.justify-content-between.mb-4 h2,
        .d-flex.justify-content-between.mb-4 h3 {
            color: #0f172a !important;
