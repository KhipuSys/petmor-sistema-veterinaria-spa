@model IEnumerable<MiniMarket.Web.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
    var categorias = Model.ToList();
    var activas = categorias.Count(c => c.Estado);
    var inactivas = categorias.Count(c => !c.Estado);
    var productosPorCategoria = ViewBag.ProductosPorCategoria as Dictionary<int, int> ?? new Dictionary<int, int>();
    var conProductos = categorias.Count(c => productosPorCategoria.TryGetValue(c.Id, out var total) && total > 0);
}

<section class="categorias-metrics">
    <article class="metric-card metric-total"><div class="metric-icon"><i class="fas fa-tags"></i></div><div><span>Categorías</span><strong>@categorias.Count</strong><small>Clasificación de productos</small></div></article>
    <article class="metric-card metric-active"><div class="metric-icon"><i class="fas fa-check"></i></div><div><span>Activas</span><strong>@activas</strong><small>Disponibles para catálogo</small></div></article>
    <article class="metric-card metric-inactive"><div class="metric-icon"><i class="fas fa-ban"></i></div><div><span>Inactivas</span><strong>@inactivas</strong><small>Ocultas operativamente</small></div></article>
    <article class="metric-card metric-linked"><div class="metric-icon"><i class="fas fa-boxes-stacked"></i></div><div><span>Con productos</span><strong>@conProductos</strong><small>Categorías en uso</small></div></article>
</section>

<section class="categorias-card">
    <div class="categorias-head">
        <div class="categorias-title"><div class="categorias-icon"><i class="fas fa-tags"></i></div><div><h2>Categorías</h2><p>Organiza productos por familias, estados y uso operativo</p></div></div>
        <a asp-action="Create" class="btn btn-categorias-primary"><i class="fas fa-plus me-2"></i>Nueva categoría</a>
    </div>

    <div class="categorias-filter-row">
        <div class="category-search"><i class="fas fa-search"></i><input id="buscarCategoria" type="search" placeholder="Buscar por nombre o descripción" autocomplete="off" /></div>
    </div>

    <div class="categorias-tools">
        <span>Filtros rápidos:</span>
        <button type="button" class="quick-chip active" data-filter="todos"><i class="fas fa-list"></i>Todos</button>
        <button type="button" class="quick-chip" data-filter="activo"><i class="fas fa-check"></i>Activas</button>
        <button type="button" class="quick-chip" data-filter="inactivo"><i class="fas fa-ban"></i>Inactivas</button>
        <button type="button" class="quick-chip" data-filter="conproductos"><i class="fas fa-boxes-stacked"></i>Con productos</button>
        <button type="button" class="quick-chip" data-filter="sinproductos"><i class="fas fa-box-open"></i>Sin productos</button>
        <div class="export-actions">
            <button type="button" class="export-btn" id="btnExportExcel"><i class="fas fa-file-excel"></i>Excel</button>
            <button type="button" class="export-btn" id="btnExportPdf"><i class="fas fa-file-pdf"></i>PDF</button>
            <button type="button" class="export-btn" id="btnExportPrint"><i class="fas fa-print"></i>Imprimir</button>
        </div>
    </div>

    <div class="table-responsive categorias-table-wrap">
        <table class="table categorias-table align-middle" id="tablaCategorias">
            <thead><tr><th>ID</th><th>Categoría</th><th>Descripción</th><th class="text-center">Productos</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
            @foreach (var item in categorias)
            {
                var totalProductos = productosPorCategoria.TryGetValue(item.Id, out var total) ? total : 0;
                <tr data-activo="@(item.Estado ? "true" : "false")" data-inactivo="@(!item.Estado ? "true" : "false")" data-conproductos="@(totalProductos > 0 ? "true" : "false")" data-sinproductos="@(totalProductos == 0 ? "true" : "false")">
                    <td><strong>#@item.Id.ToString("D4")</strong></td>
                    <td><strong>@item.Nombre</strong><small>Familia de productos</small></td>
                    <td><span class="description-text">@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción" : item.Descripcion)</span></td>
                    <td class="text-center"><span class="count-pill @(totalProductos > 0 ? "count-linked" : "count-empty")"><i class="fas @(totalProductos > 0 ? "fa-boxes-stacked" : "fa-box-open")"></i>@totalProductos</span></td>
                    <td>@if (item.Estado) { <span class="status-pill status-active"><i class="fas fa-circle"></i>Activa</span> } else { <span class="status-pill status-inactive"><i class="fas fa-circle"></i>Inactiva</span> }</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn category-action action-edit" title="Editar"><i class="fas fa-pen"></i></a>
                        @if (item.Estado)
                        {
                            <form asp-action="CambiarEstado" asp-route-id="@item.Id" method="post" class="d-inline form-toggle" data-title="Desactivar categoría" data-text="La categoría quedará inactiva para la operación."><button type="submit" class="btn category-action action-power" title="Desactivar"><i class="fas fa-power-off"></i></button></form>
                        }
                        else
                        {
                            <form asp-action="CambiarEstado" asp-route-id="@item.Id" method="post" class="d-inline form-toggle" data-title="Activar categoría" data-text="La categoría volverá a estar disponible."><button type="submit" class="btn category-action action-power-on" title="Activar"><i class="fas fa-power-off"></i></button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (!categorias.Any())
    {
        <div class="categorias-empty"><i class="fas fa-tags"></i><h3>Sin categorías registradas</h3><p>Crea categorías para ordenar el catálogo de productos.</p><a asp-action="Create" class="btn btn-categorias-primary">Nueva categoría</a></div>
    }
</section>

<style>
    .categorias-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-bottom: 22px; }
    .metric-card { min-height: 112px; display: flex; align-items: center; gap: 16px; padding: 20px; border: 1px solid #e5e7eb; border-radius: 14px; background: linear-gradient(135deg, #fff, #fbfdff); }
    .metric-icon { width: 58px; height: 58px; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 25px; flex: 0 0 auto; }
    .metric-card span { color: #64748b; font-weight: 900; font-size: .82rem; text-transform: uppercase; letter-spacing: .05em; }
    .metric-card strong { display: block; margin-top: 2px; color: #0f172a; font-size: 1.6rem; line-height: 1; font-weight: 900; }
    .metric-card small { display: block; margin-top: 8px; color: #64748b; font-weight: 600; }
    .metric-total .metric-icon { background: #fff3ea; color: #f06800; } .metric-active .metric-icon { background: #ecfdf5; color: #059669; } .metric-inactive .metric-icon { background: #fee2e2; color: #dc2626; } .metric-linked .metric-icon { background: #eff6ff; color: #2563eb; }
    .categorias-card { border: 1px solid #e5e7eb; border-radius: 14px; background: #fff; overflow: hidden; }
    .categorias-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; border-bottom: 1px solid #e5e7eb; background: linear-gradient(135deg, #fff, #f8fafc); }
    .categorias-title { display: flex; align-items: center; gap: 12px; } .categorias-icon { width: 42px; height: 42px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; background: #fff3ea; color: #f06800; }
    .categorias-title h2 { margin: 0; color: #0f172a; font-size: 1.1rem; font-weight: 900; } .categorias-title p { margin: 3px 0 0; color: #64748b; font-size: .92rem; }
    .btn-categorias-primary { min-height: 46px; border-radius: 10px; padding: 11px 18px; background: #f06800; border: 1px solid #f06800; color: #fff !important; font-weight: 900; } .btn-categorias-primary:hover { background: #d95f00; color: #fff !important; }
    .categorias-filter-row { padding: 14px 20px 0; }
    .category-search { min-height: 46px; display: flex; align-items: center; gap: 10px; border: 1px solid #dbe3ee; border-radius: 10px; padding: 0 13px; color: #64748b; }
    .category-search input { width: 100%; border: 0; outline: 0; color: #0f172a; font-weight: 700; background: transparent; }
    .categorias-tools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 14px 20px 0; color: #475569; font-weight: 900; font-size: .86rem; }
    .quick-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 34px; padding: 6px 12px; border-radius: 999px; border: 1px solid #fed7aa; background: #fff; color: #f06800; font-size: .82rem; font-weight: 900; }
    .quick-chip.active, .quick-chip:hover { background: #f06800; color: #fff; border-color: #f06800; }
    .export-actions { display: inline-flex; gap: 8px; flex-wrap: wrap; margin-left: auto; }
    .export-btn { min-height: 34px; display: inline-flex; align-items: center; gap: 6px; border-radius: 9px; border: 1px solid #fed7aa; background: #fff; color: #f06800; padding: 6px 12px; font-size: .82rem; font-weight: 900; }
    .export-btn:hover { background: #fff7ed; color: #c2410c; }
    .categorias-table-wrap { margin: 18px; border: 1px solid #e5e7eb; border-radius: 12px; }
    .categorias-table { margin: 0; min-width: 920px; }
    .categorias-table thead th { background: #f8fafc !important; color: #0f172a; font-weight: 900; padding: 16px 18px; border-bottom: 1px solid #e2e8f0; font-size: .88rem; }
    .categorias-table tbody td { padding: 18px; border-bottom: 1px solid #e2e8f0; color: #334155; vertical-align: middle; }
    .categorias-table tbody tr:last-child td { border-bottom: 0; } .categorias-table strong { display: block; color: #0f172a; font-weight: 900; } .categorias-table small { display: block; color: #64748b; margin-top: 3px; }
    .description-text { color: #334155; font-weight: 700; }
    .status-pill, .count-pill { display: inline-flex; align-items: center; gap: 7px; border-radius: 999px; padding: 8px 13px; font-weight: 900; font-size: .8rem; }
    .status-active { background: #ecfdf5; color: #059669; } .status-inactive { background: #fee2e2; color: #dc2626; } .count-linked { background: #eff6ff; color: #2563eb; } .count-empty { background: #f1f5f9; color: #64748b; }
    .category-action { width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border-radius: 9px; background: #fff; margin-left: 4px; }
    .action-edit { color: #f06800; border: 1px solid #fb923c; } .action-edit:hover { background: #fff7ed; color: #c2410c; }
    .action-power { color: #dc2626; border: 1px solid #fecaca; } .action-power:hover { background: #fef2f2; color: #b91c1c; }
    .action-power-on { color: #059669; border: 1px solid #bbf7d0; } .action-power-on:hover { background: #ecfdf5; color: #047857; }
    .categorias-empty { display: grid; place-items: center; padding: 44px 16px; text-align: center; color: #64748b; }
    .categorias-empty i { width: 58px; height: 58px; display: inline-flex; align-items: center; justify-content: center; border-radius: 16px; background: #fff3ea; color: #f06800; font-size: 26px; margin-bottom: 12px; }
    .categorias-empty h3 { color: #0f172a; font-size: 1.2rem; font-weight: 900; margin: 0; }
    .categorias-empty p { margin: 6px 0 14px; }
    .dataTables_wrapper { padding: 0 18px 18px; } .dataTables_wrapper .dt-buttons .btn { border-radius: 9px; font-weight: 900; margin-right: 6px; border: 1px solid #fed7aa !important; background: #fff !important; color: #f06800 !important; } .dataTables_wrapper .dt-buttons .btn:hover { background: #fff7ed !important; color: #c2410c !important; } .dataTables_filter { display: none; } .dataTables_length select { border: 1px solid #dbe3ee; border-radius: 9px; padding: 6px 10px; }
    @@media (max-width: 1199.98px) { .categorias-metrics { grid-template-columns: 1fr 1fr; } }
    @@media (max-width: 767.98px) { .categorias-metrics { grid-template-columns: 1fr; } .categorias-head { align-items: flex-start; flex-direction: column; } .btn-categorias-primary { width: 100%; } .export-actions { margin-left: 0; width: 100%; } }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable.isDataTable('#tablaCategorias')) $('#tablaCategorias').DataTable().destroy();
            let filtroRapido = 'todos';
            $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
                if (settings.nTable.id !== 'tablaCategorias' || filtroRapido === 'todos') return true;
                const row = settings.aoData[dataIndex].nTr;
                if (!row) return true;
                return row.dataset[filtroRapido] === 'true';
            });
            const tabla = $('#tablaCategorias').DataTable({
                dom: PetmorTables.dom,
                buttons: PetmorTables.exportButtons('Categorías Petmor'),
                order: [[1, 'asc']],
            });
            $('#buscarCategoria').on('input', function() { tabla.search(this.value).draw(); });
            $('.quick-chip').on('click', function() {
                $('.quick-chip').removeClass('active');
                $(this).addClass('active');
                filtroRapido = $(this).data('filter');
                tabla.draw();
            });
            $('#btnExportExcel').on('click', () => tabla.button('.buttons-excel').trigger());
            $('#btnExportPdf').on('click', () => tabla.button('.buttons-pdf').trigger());
            $('#btnExportPrint').on('click', () => tabla.button('.buttons-print').trigger());
        });
    </script>
}
