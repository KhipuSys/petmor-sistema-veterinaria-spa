    <script>
        (() => {
            const campoDesdeNombre = (nombre) => {
                if (!nombre) return '';
                const input = document.querySelector(`[name="${CSS.escape(nombre)}"], #${CSS.escape(nombre)}`);
                const id = input?.id || nombre;
                const label = document.querySelector(`label[for="${CSS.escape(id)}"]`);
                return (label?.textContent || nombre)
                    .replace(/\*/g, '')
                    .replace(/\s+/g, ' ')
                    .trim();
            };

            const etiquetaDeCampo = (campo) => {
                if (!campo) return null;
                if (campo.id) {
                    const porId = document.querySelector(`label[for="${CSS.escape(campo.id)}"]`);
                    if (porId) return porId;
                }
                const contenedora = campo.closest('label');
                if (contenedora) return contenedora;
                return campo.closest('.mb-3,.mb-4,.my-4,.field-wrap,.form-group,[class*="col-"]')?.querySelector('label') || null;
            };

            const marcarCamposObligatorios = (scope = document) => {
                scope.querySelectorAll('input, select, textarea').forEach(campo => {
                    const tipo = (campo.getAttribute('type') || '').toLowerCase();
                    if (tipo === 'hidden' || tipo === 'checkbox' || tipo === 'radio') return;
                    const label = etiquetaDeCampo(campo);
                    if (!label) return;
                    const requerida = !campo.disabled && !campo.readOnly && (campo.required || campo.hasAttribute('data-val-required'));
                    if (!requerida) { label.querySelector('.required-mark')?.remove(); campo.removeAttribute('aria-required'); return; }
                    campo.setAttribute('aria-required', 'true');
                    if (label.querySelector('.required-mark')) return;
                    const existente = Array.from(label.querySelectorAll('span')).find(s => s.textContent.trim() === '*');
                    if (existente) { existente.classList.add('required-mark'); existente.setAttribute('aria-hidden', 'true'); return; }
                    if (label.textContent.includes('*')) return;
                    const marca = document.createElement('span');
                    marca.className = 'required-mark';
                    marca.setAttribute('aria-hidden', 'true');
                    marca.textContent = '*';
                    label.appendChild(marca);
                });
            };

            const normalizarError = (texto) => {
                texto = String(texto || '').replace(/\s+/g, ' ').trim();
                const requerido = texto.match(/^The (.+) field is required\.$/i);
                if (requerido) {
                    const campo = campoDesdeNombre(requerido[1]);
                    return campo ? `Completa: ${campo}.` : 'Completa los campos obligatorios.';
                }
                return texto;
            };

            const mensajeValidacionCampo = (campo) => {
                const nombreCampo = campoDesdeNombre(campo?.name || campo?.id);
                if (campo?.validity?.valueMissing) {
                    return nombreCampo ? `Completa: ${nombreCampo}.` : 'Completa los campos obligatorios.';
                }
                if (campo?.validity?.patternMismatch) {
                    return nombreCampo ? `Revisa el formato de: ${nombreCampo}.` : 'Revisa el formato del campo.';
                }
                if (campo?.validity?.tooShort) {
                    return nombreCampo ? `${nombreCampo} debe tener más caracteres.` : 'El campo debe tener más caracteres.';
                }
                if (campo?.validity?.tooLong) {
                    return nombreCampo ? `${nombreCampo} excede el máximo permitido.` : 'El campo excede el máximo permitido.';
                }
                if (campo?.validity?.typeMismatch) {
                    return nombreCampo ? `Revisa el valor de: ${nombreCampo}.` : 'Revisa el valor ingresado.';
                }
                return normalizarError(campo?.validationMessage || (nombreCampo ? `Revisa: ${nombreCampo}.` : 'Revisa los campos marcados.'));
            };

            const erroresVisibles = (scope = document) => {
                const errores = [];
                scope.querySelectorAll('.validation-summary-errors li, .field-validation-error').forEach(el => {
                    const texto = normalizarError(el.textContent);
                    if (texto && !errores.includes(texto)) errores.push(texto);
                });
                return errores;
            };

            const mostrarErrores = (errores) => {
                errores = [...new Set((errores || []).filter(Boolean))];
                if (!errores.length || !window.Swal) return;
                Swal.fire({
                    title: 'Revisa el formulario',
                    html: `<div style="text-align:center">${errores.map(e => `<div>${PetmorImportes.texto(e)}</div>`).join('')}</div>`,
                    icon: 'warning',
                    confirmButtonColor: '#f06800'
                });
            };

            const mostrarCamposInvalidos = (form) => {
                const errores = Array.from(form.elements)
                    .filter(el => el.willValidate && !el.validity.valid)
                    .map(el => mensajeValidacionCampo(el));
                mostrarErrores(errores);
            };

            document.addEventListener('DOMContentLoaded', () => {
                marcarCamposObligatorios();
                new MutationObserver(cambios => {
                    if (cambios.some(c => c.type === 'attributes' || Array.from(c.addedNodes).some(n => n.nodeType === 1 && !n.matches('.required-mark'))))
                        marcarCamposObligatorios();
                }).observe(document.body, { subtree: true, childList: true, attributes: true, attributeFilter: ['required', 'disabled', 'readonly', 'data-val-required'] });
                if (!window.Swal?.isVisible?.()) mostrarErrores(erroresVisibles());

                if (window.jQuery) {
                    jQuery(document).on('invalid-form.validate', 'form', function (_event, validator) {
                        const errores = (validator.errorList || []).map(error => `${campoDesdeNombre(error.element.name || error.element.id)}: ${normalizarError(error.message)}`);
                        mostrarErrores(errores.length ? errores : erroresVisibles(this));
                    });
                }

                document.querySelectorAll('form').forEach(form => {
                    form.addEventListener('submit', (event) => {
                        let errores = [];

                        if (window.jQuery && jQuery.fn?.valid && jQuery(form).data('validator')) {
                            const valido = jQuery(form).valid();
                            if (!valido) {
                                const validator = jQuery(form).data('validator');
                                errores = (validator.errorList || []).map(error => {
                                    const campo = error.element?.name || error.element?.id;
                                    return normalizarError(error.message || `Completa: ${campoDesdeNombre(campo)}.`);
                                });
                            }
                        } else if (!form.checkValidity()) {
                            errores = Array.from(form.elements)
                                .filter(el => el.willValidate && !el.validity.valid)
                                .map(el => mensajeValidacionCampo(el));
                        }

                        if (errores.length) {
                            event.preventDefault();
                            event.stopPropagation();
                            mostrarErrores(errores);
                        }
                    }, true);
                });
            });

            const validacionPendiente = new WeakMap();
            document.addEventListener('invalid', (event) => {
                const campo = event.target;
                if (!campo?.form) return;
                clearTimeout(validacionPendiente.get(campo.form));
                validacionPendiente.set(campo.form, setTimeout(() => mostrarCamposInvalidos(campo.form), 0));
            }, true);
        })();
    </script>
