@page
@model Petmor.Web.Areas.Identity.Pages.Account.LoginWith2faModel

@{
    Layout = null;
    ViewData["Title"] = "Verificación en dos pasos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verificación 2FA - Petmor</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root { --petmor-orange: #f06800; }
        body { min-height: 100vh; display: grid; place-items: center; margin: 0; padding: 24px; background: #f8fafc; font-family: 'Outfit', sans-serif; }
        .auth-card { width: 100%; max-width: 430px; padding: 34px; border: 1px solid #e2e8f0; border-radius: 18px; background: #fff; box-shadow: 0 20px 45px rgba(15,23,42,.12); }
        .auth-icon { display: inline-grid; place-items: center; width: 68px; height: 68px; margin-bottom: 18px; border-radius: 18px; background: #fff3ea; color: var(--petmor-orange); font-size: 1.8rem; }
        .form-control { min-height: 52px; border-radius: 12px; font-size: 1.25rem; letter-spacing: .25rem; text-align: center; }
        .btn-primary { min-height: 48px; border-color: var(--petmor-orange); background: var(--petmor-orange); font-weight: 700; }
        .btn-primary:hover { border-color: #c65300; background: #c65300; }
        a:focus-visible, button:focus-visible, input:focus-visible { outline: 3px solid #9a3412; outline-offset: 3px; }
    </style>
</head>
<body>
    <main class="auth-card">
        <div class="text-center">
            <div class="auth-icon" aria-hidden="true"><i class="fas fa-shield-alt"></i></div>
            <h1 class="h3 fw-bold mb-2">Código de Authy</h1>
            <p class="text-muted mb-4">Ingresa el código de seis dígitos generado por Authy para completar el inicio de sesión.</p>
        </div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.TwoFactorCode" class="form-label fw-semibold">Código de verificación</label>
                <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="one-time-code" inputmode="numeric" maxlength="7" autofocus />
                <span asp-validation-for="Input.TwoFactorCode" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Verificar e ingresar</button>
        </form>
        <div class="text-center mt-3">
            <a asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="small">Usar código de recuperación</a>
        </div>
    </main>
</body>
</html>
