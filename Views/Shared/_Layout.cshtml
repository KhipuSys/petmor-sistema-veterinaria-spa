    <!-- SCRIPTS DE CONTROL DE WIDGETS -->
    <script>
        // Crear elementos del cursor animado (punto central y halo grande con latido)
        const cursorDot = document.createElement('div');
        cursorDot.className = 'custom-cursor-dot';
        cursorDot.style.display = 'none';
        document.body.appendChild(cursorDot);

        const cursorHalo = document.createElement('div');
        cursorHalo.className = 'custom-cursor-halo';
        cursorHalo.style.display = 'none';
        document.body.appendChild(cursorHalo);

        // Seguir el movimiento del mouse
        window.addEventListener('mousemove', (e) => {
            if (document.body.classList.contains('cursor-grande')) {
                cursorDot.style.display = 'block';
                cursorHalo.style.display = 'block';
                
                cursorDot.style.left = e.clientX + 'px';
                cursorDot.style.top = e.clientY + 'px';
                
                cursorHalo.style.left = e.clientX + 'px';
                cursorHalo.style.top = e.clientY + 'px';
            }
        });

        // Cargar preferencias guardadas al iniciar
        document.addEventListener("DOMContentLoaded", function() {
            let savedContraste = localStorage.getItem('modoContraste');
            if (savedContraste) {
                tipoContraste = parseInt(savedContraste);
                aplicarContrasteVisual(tipoContraste);
            }
            if (localStorage.getItem('dislexia') === 'true') {
                document.body.classList.add('dislexia-amigable');
                actualizarBarraDoble('d', true);
            }
            if (localStorage.getItem('cursorGrande') === 'true') {
                document.body.classList.add('cursor-grande');
                actualizarBarraDoble('u', true);
                cursorDot.style.display = 'block';
                cursorHalo.style.display = 'block';
            }
            let savedSize = localStorage.getItem('tamanioTexto');
            if (savedSize) {
                nivelTexto = parseInt(savedSize);
                const tamanios = [16, 18, 20, 22];
                document.body.style.fontSize = tamanios[nivelTexto] + 'px';
                actualizarBarrasTexto(nivelTexto);
            }
        });

        document.getElementById('accessibility-toggle-btn').addEventListener('click', function(e) {
            e.stopPropagation();
            const panel = document.getElementById('accessibility-panel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        });
        document.getElementById('accessibility-close-btn').addEventListener('click', function() {
            document.getElementById('accessibility-panel').style.display = 'none';
        });
        window.addEventListener('click', function(e) {
            const panel = document.getElementById('accessibility-panel');
            const btn = document.getElementById('accessibility-toggle-btn');
            if (!panel.contains(e.target) && !btn.contains(e.target)) {
                panel.style.display = 'none';
            }
        });

        let nivelTexto = 0; 
        function ciclarTamanioTexto() {
            nivelTexto = (nivelTexto + 1) % 4;
            localStorage.setItem('tamanioTexto', nivelTexto);
            actualizarBarrasTexto(nivelTexto);
            const tamanios = [16, 18, 20, 22];
            document.body.style.fontSize = tamanios[nivelTexto] + 'px';
        }

        function actualizarBarrasTexto(nivel) {
            const barras = document.querySelectorAll('.bar-t');
            barras.forEach((b, index) => {
                b.style.background = index === nivel ? '#334155' : '#cbd5e1';
            });
        }
        
        let tipoContraste = 0; 
        function toggleAltoContraste() {
            tipoContraste = (tipoContraste + 1) % 3;
            localStorage.setItem('modoContraste', tipoContraste);
            aplicarContrasteVisual(tipoContraste);
        }

        function aplicarContrasteVisual(tipo) {
            document.body.classList.remove('contraste-oscuro', 'contraste-suave');
            tipoContraste = [0, 1, 2].includes(tipo) ? tipo : 0;
            if (tipoContraste === 0) document.body.removeAttribute('data-contrast');
            else document.body.dataset.contrast = tipoContraste === 1 ? 'dark' : 'light';
            document.getElementById('contrast-label').textContent = ['Contraste: normal', 'Alto contraste oscuro', 'Alto contraste claro'][tipoContraste];

            const barras = document.querySelectorAll('.bar-c');
            barras.forEach((b, index) => {
                b.style.background = index === tipoContraste ? '#334155' : '#cbd5e1';
                b.dataset.selected = String(index === tipoContraste);
            });
        }
        
        function actualizarBarraDoble(clase, activo) {
            const barras = document.querySelectorAll(`.bar-${clase}`);
            if (barras.length === 2) {
                barras[0].style.background = activo ? '#cbd5e1' : '#334155';
                barras[1].style.background = activo ? '#334155' : '#cbd5e1';
            }
        }

        function toggleCursorGrande() {
            document.body.classList.toggle('cursor-grande');
            const activo = document.body.classList.contains('cursor-grande');
            localStorage.setItem('cursorGrande', activo);
            actualizarBarraDoble('u', activo);

            if (activo) {
                cursorDot.style.display = 'block';
                cursorHalo.style.display = 'block';
            } else {
                cursorDot.style.display = 'none';
                cursorHalo.style.display = 'none';
            }
        }

        function toggleDislexia() {
            document.body.classList.toggle('dislexia-amigable');
            const activo = document.body.classList.contains('dislexia-amigable');
            localStorage.setItem('dislexia', activo);
            actualizarBarraDoble('d', activo);
        }

        function restablecerAccesibilidad() {
            document.body.classList.remove('dislexia-amigable', 'cursor-grande', 'contraste-oscuro', 'contraste-suave');
            document.body.style.fontSize = '';
            nivelTexto = 0;
            tipoContraste = 0;
            ['modoContraste', 'dislexia', 'cursorGrande', 'tamanioTexto'].forEach(key => localStorage.removeItem(key));

            cursorDot.style.display = 'none';
            cursorHalo.style.display = 'none';

            actualizarBarrasTexto(0);
            aplicarContrasteVisual(0);
            actualizarBarraDoble('u', false);
            actualizarBarraDoble('d', false);
        }

    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
