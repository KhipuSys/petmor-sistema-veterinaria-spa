@model Petmor.Web.Models.Producto
@inject Petmor.Web.Services.SedeActual Sede

@{
    var esEdicion = Model.Id > 0;
    var titulo = esEdicion ? "Editar Producto" : "Registrar Producto";
    var subtitulo = esEdicion ? "Modifica la informacion del producto y manten el inventario actualizado." : "Registra la informacion comercial y el inventario inicial del producto.";
    var accion = esEdicion ? "Edit" : "Create";
    var textoBoton = esEdicion ? "Guardar Cambios" : "Guardar Producto";
}

<style>
    .producto-shell {
        background: linear-gradient(135deg, #f8fbff 0%, #eef3f8 100%);
        border-radius: 22px;
        padding: 1.5rem;
    }

    .producto-card {
        border: 0;
        border-radius: 18px;
    }

    .producto-icon {
        width: 58px;
        height: 58px;
        border-radius: 12px;
        background: linear-gradient(135deg, #ff7a2a, var(--brand-primary));
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

    .producto-label {
        font-weight: 700;
        color: #14213d;
        margin-bottom: .45rem;
    }

    .producto-label i {
        color: var(--brand-primary);
        min-width: 22px;
    }

    .producto-card .form-control,
    .producto-card .form-select,
    .producto-card .input-group-text {
        border-color: #d6e0ea;
        border-radius: 8px;
        min-height: 42px;
    }

    .producto-card .input-group .form-control {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }

    .producto-section {
        border: 1px solid #f3d8c6;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
    }

    .producto-section-head {
        background: linear-gradient(90deg, rgba(240, 104, 0, .12), rgba(240, 104, 0, .03));
        padding: 1rem 1.25rem;
        display: flex;
        gap: .85rem;
        align-items: center;
    }

    .producto-section-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(240, 104, 0, .12);
        color: var(--brand-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .producto-upload {
        border: 1px solid #d6e0ea;
        border-radius: 12px;
        padding: 1rem;
        background: #fbfdff;
    }

    .producto-upload-box {
        border: 1px dashed #b9c8d8;
        border-radius: 10px;
        padding: 1.5rem;
        text-align: center;
        min-height: 130px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
    }

    .producto-current-img {
        border-left: 1px solid #e3eaf2;
        min-width: 150px;
    }

    .producto-current-img img {
        max-height: 105px;
        object-fit: contain;
    }

    .producto-preview-img {
        max-height: 105px;
        object-fit: contain;
    }

    .producto-state {
        border: 1px solid #d6e0ea;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        background: #fff;
    }

    .producto-state .form-check-input {
        width: 3.25rem;
        height: 1.65rem;
        border-color: #d6e0ea;
    }

    .producto-state .form-check-input:checked {
        background-color: var(--brand-primary);
        border-color: var(--brand-primary);
    }

    .producto-sede-select {
        max-width: 280px;
    }

    .codigo-summary {
        border: 1px solid #dbe3ee;
        border-radius: 12px;
        padding: 12px 14px;
        background: #fbfdff;
        color: #334155;
    }

    .codigo-summary strong {
        color: #0f172a;
    }

    .codigo-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
    }

    .codigo-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 10px;
        background: #fff7ed;
        color: #c2410c;
        font-size: .82rem;
        font-weight: 800;
    }

    .codigo-badge-remove {
        background: #fef2f2;
        color: #b91c1c;
    }

    .codigo-badge input {
        margin: 0;
    }
</style>

<div class="producto-shell">
    <div class="card producto-card">
        <div class="card-body p-4 p-lg-5">
            <form asp-action="@accion" enctype="multipart/form-data">
                <div asp-validation-summary="All"></div>
                @if (esEdicion)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <span class="producto-icon"><i class="fas @(esEdicion ? "fa-pen" : "fa-box-open")"></i></span>
                        <div>
                            <h2 class="fw-bold mb-1 text-dark">@titulo</h2>
                            <p class="text-muted mb-0">@subtitulo</p>
                        </div>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Volver al listado</a>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-lg-8">
                        <label asp-for="Nombre" class="producto-label"><i class="fas fa-cube me-2"></i>Nombre <span class="text-danger">*</span></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: RICO CAN Adultos Bolsa 15Kg" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-lg-4">
                        <label asp-for="CodigoBarras" class="producto-label"><i class="fas fa-barcode me-2"></i>Codigo Barras</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                            <input asp-for="CodigoBarras" class="form-control" readonly placeholder="Primer código registrado" />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <label asp-for="Descripcion" class="producto-label"><i class="fas fa-file-alt me-2"></i>Descripcion</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="5" maxlength="500"></textarea>
                    </div>
                    <div class="col-lg-6">
                        <label class="producto-label"><i class="fas fa-image me-2"></i>Imagen</label>
                        <div class="producto-upload d-flex gap-3 flex-column flex-md-row">
                            <div class="producto-upload-box flex-fill">
                                <i class="fas fa-cloud-upload-alt fs-2 text-primary mb-2"></i>
                                <label class="btn btn-link text-dark text-decoration-none p-0 mb-1">
                                    Seleccionar archivo
                                    <input type="file" id="imagenArchivo" name="imagenArchivo" class="d-none" accept="image/*" />
                                </label>
                                <small class="text-muted">JPG, PNG o WEBP</small>
                                <small class="text-primary fw-semibold d-none mt-2" id="nombreImagenSeleccionada"></small>
                            </div>
                            <div id="previewImagenNueva" class="producto-current-img text-center ps-md-3 d-none">
                                <small class="d-block text-muted mb-2">Vista previa</small>
                                <img id="imgPreviewProducto" src="" alt="Vista previa" class="img-fluid rounded producto-preview-img" />
                            </div>
                            @if (esEdicion && !string.IsNullOrEmpty(Model.ImagenUrl))
                            {
                                <div id="imagenActualProducto" class="producto-current-img text-center ps-md-3">
                                    <small class="d-block text-muted mb-2">Imagen actual</small>
                                    <img src="@Model.ImagenUrl" alt="Imagen actual" class="img-fluid rounded" />
                                    <div class="form-check mt-3 text-start">
                                        <input class="form-check-input" type="checkbox" id="eliminarImagen" name="eliminarImagen" value="true" />
                                        <label class="form-check-label small text-danger fw-semibold" for="eliminarImagen">Eliminar imagen guardada</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <label asp-for="CategoriaId" class="producto-label"><i class="fas fa-tag me-2"></i>Categoria</label>
                        <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId"></select>
                    </div>
                </div>

                @if (esEdicion)
                {
                    var codigosActuales = Model.Codigos.Select(c => c.Codigo).OrderBy(c => c).ToList();
                    <div class="codigo-summary mb-3">
                        <strong>@codigosActuales.Count código@(codigosActuales.Count == 1 ? "" : "s") asociado@(codigosActuales.Count == 1 ? "" : "s")</strong>
                        <small class="d-block text-muted">Los códigos identifican unidades o etiquetas del producto. Para mover stock, usa el ajuste de esta misma pantalla.</small>
                        <small class="d-block text-muted">Stock actual en esta sede: <strong>@Model.Stock unidad@(Model.Stock == 1 ? "" : "es")</strong>.</small>
                        @if (codigosActuales.Any())
                        {
                            <div class="codigo-badges" aria-label="Códigos asociados">
                                @foreach (var codigo in codigosActuales)
                                {
                                    <span class="codigo-badge">
                                        <i class="fas fa-barcode"></i>@codigo
                                    </span>
                                }
                            </div>
                        }
                    </div>
                    <div class="producto-section mb-3">
                        <div class="producto-section-head">
                            <span class="producto-section-icon"><i class="fas fa-boxes-stacked"></i></span>
                            <div>
                                <h6 class="fw-bold mb-0">Ajuste de stock</h6>
                                <small class="text-muted">Gestiona entradas y salidas desde la edición del producto.</small>
                            </div>
                        </div>
                        <div class="p-3 p-lg-4">
                            <input type="hidden" name="operacionId" value="@(ViewBag.OperacionId ?? Guid.NewGuid())" />
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="producto-label" for="tipoAjuste">Movimiento</label>
                                    <select id="tipoAjuste" name="tipoAjuste" class="form-select">
                                        <option value="">Sin movimiento</option>
                                        <option value="ENTRADA" selected="@(ViewBag.TipoAjuste as string == "ENTRADA")">Entrada</option>
                                        <option value="SALIDA" selected="@(ViewBag.TipoAjuste as string == "SALIDA")">Salida</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="producto-label" for="cantidadAjuste">Cantidad</label>
                                    <input id="cantidadAjuste" name="cantidad" type="number" min="0" step="1" class="form-control fw-bold text-center" value="0" readonly />
                                </div>
                                <div class="col-md-4">
                                    <label class="producto-label" for="motivo">Motivo del Ajuste</label>
                                    <select id="motivo" name="motivo" class="form-select">
                                        <option value="">-- Seleccione primero el movimiento --</option>
                                        <option data-movimiento="ENTRADA" value="Ingreso físico por escaneo" selected="@(ViewBag.MotivoAjuste as string == "Ingreso físico por escaneo")">Ingreso físico por escaneo</option>
                                        <option data-movimiento="ENTRADA" value="Reposición registrada fuera del sistema" selected="@(ViewBag.MotivoAjuste as string == "Reposición registrada fuera del sistema")">Reposición registrada fuera del sistema</option>
                                        <option data-movimiento="ENTRADA" value="Ajuste positivo por inventario físico" selected="@(ViewBag.MotivoAjuste as string == "Ajuste positivo por inventario físico")">Ajuste positivo por inventario físico</option>
                                        <option data-movimiento="ENTRADA" value="Corrección de códigos asociados" selected="@(ViewBag.MotivoAjuste as string == "Corrección de códigos asociados")">Corrección de códigos asociados</option>
                                        <option data-movimiento="SALIDA" value="Producto dañado" selected="@(ViewBag.MotivoAjuste as string == "Producto dañado")">Producto dañado</option>
                                        <option data-movimiento="SALIDA" value="Merma / vencimiento" selected="@(ViewBag.MotivoAjuste as string == "Merma / vencimiento")">Merma / vencimiento</option>
                                        <option data-movimiento="SALIDA" value="Pérdida o robo" selected="@(ViewBag.MotivoAjuste as string == "Pérdida o robo")">Pérdida o robo</option>
                                        <option data-movimiento="SALIDA" value="Ajuste negativo por inventario físico" selected="@(ViewBag.MotivoAjuste as string == "Ajuste negativo por inventario físico")">Ajuste negativo por inventario físico</option>
                                        <option data-movimiento="SALIDA" value="Corrección administrativa" selected="@(ViewBag.MotivoAjuste as string == "Corrección administrativa")">Corrección administrativa</option>
                                    </select>
                                </div>
                            </div>
                            @{ ViewData["LecturasModo"] = "producto-ajuste"; ViewData["LecturasCantidad"] = "#cantidadAjuste"; ViewData["LecturasProducto"] = "[name='Id']"; ViewData["PermitirExcepcionManual"] = false; }
                            <partial name="_Lecturas" />
                        </div>
                    </div>
                }
                else
                {
                    ViewData["LecturasModo"] = "alta";
                    ViewData["LecturasCantidad"] = "#Stock";
                    ViewData["LecturasProducto"] = "[name='Id']";
                    ViewData["PermitirExcepcionManual"] = false;
                    <partial name="_Lecturas" />
                }
                <div class="producto-section mb-3">
                    <div class="producto-section-head">
                        <span class="producto-section-icon"><i class="fas fa-coins"></i></span>
                        <div>
                            <h6 class="fw-bold mb-0">Precios e inventario</h6>
                            <small class="text-muted">Define los valores de venta, costo y control de stock del producto.</small>
                        </div>
                    </div>
                    <div class="p-3 p-lg-4">
                        <div class="row g-4">
                            <div class="col-md-3">
                                <label asp-for="Precio" class="producto-label"><i class="fas fa-wallet me-2"></i>Precio <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text fw-bold">S/.</span>
                                    <input asp-for="Precio" type="number" step="0.01" class="form-control fw-bold" />
                                </div>
                                <span asp-validation-for="Precio" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Costo" class="producto-label"><i class="fas fa-coins me-2"></i>Costo <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text fw-bold">S/.</span>
                                    <input asp-for="Costo" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Stock" class="producto-label"><i class="fas fa-cube me-2"></i>Stock <span class="text-danger">*</span></label>
                                <input asp-for="Stock" type="number" step="1" min="0" class="form-control" readonly />
                                @if (esEdicion) { <small class="text-muted">La existencia cambia con el ajuste de stock de esta pantalla.</small> }
                            </div>
                            <div class="col-md-3">
                                <label asp-for="StockMinimo" class="producto-label"><i class="fas fa-exclamation-triangle me-2"></i>Minimo <span class="text-danger">*</span></label>
                                <input asp-for="StockMinimo" type="number" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="producto-state d-flex align-items-center gap-3 mb-3">
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" asp-for="Estado" />
                    </div>
                    <div>
                        <label class="fw-bold mb-0" asp-for="Estado">Producto Activo</label>
                        <small class="d-block text-muted">El producto estara disponible en el sistema.</small>
                    </div>
                </div>

                <partial name="_UsoVeterinario" model="Model" />
                <div class="producto-state mb-3">
                    <div class="form-check form-switch d-flex align-items-center gap-3 ps-0">
                        <input asp-for="ConCaducidad" class="form-check-input float-none ms-0 mt-0 flex-shrink-0" type="checkbox" />
                        <label asp-for="ConCaducidad" class="form-check-label fw-bold">Producto con caducidad</label>
                    </div>
                    <div id="campoVencimiento" class="mt-3">
                        <label asp-for="FechaVencimiento" class="producto-label">Fecha de vencimiento</label>
                        <input asp-for="FechaVencimiento" type="date" class="form-control" />
                        <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
                        <small class="text-muted">Registra la fecha más cercana de las unidades disponibles. Alerta desde 30 días antes; los vencidos no se pueden vender ni reservar.</small>
                    </div>
                </div>

                @if (esEdicion && Sede.Id > 0)
                {
                    <div class="producto-state d-flex align-items-center justify-content-between gap-3 flex-wrap mb-3">
                        <div>
                            <label class="fw-bold mb-0" for="sedeStockProducto"><i class="fas fa-map-marker-alt me-2 text-primary"></i>Sede del stock</label>
                            <small class="d-block text-muted">El producto es compartido; el stock mostrado corresponde a la sede seleccionada.</small>
                        </div>
                        <select id="sedeStockProducto" class="form-select producto-sede-select" @(Sede.PuedeCambiar ? null : "disabled")>
                            @foreach (var sede in Sede.Disponibles)
                            {
                                <option value="@sede.Id" selected="@(sede.Id == Sede.Id)">@sede.Nombre</option>
                            }
                        </select>
                    </div>
                }

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-times me-2"></i>Cancelar</a>
                    <button type="submit" class="btn btn-primary px-5"><i class="fas fa-check me-2"></i>@textoBoton</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/lecturas.js" asp-append-version="true"></script>
<script>
    (() => {
        const caducidad = document.getElementById('ConCaducidad');
        const vencimiento = document.getElementById('FechaVencimiento');
        function mostrarVencimiento() {
            document.getElementById('campoVencimiento').hidden = !caducidad.checked;
            vencimiento.required = caducidad.checked;
            vencimiento.disabled = !caducidad.checked;
        }
        caducidad.addEventListener('change', mostrarVencimiento);
        mostrarVencimiento();
        // Los lectores suelen finalizar el código con Enter: no enviar el formulario.
        document.getElementById('CodigoBarras')?.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
                event.preventDefault();
                event.stopPropagation();
            }
        });
        const tipoAjuste = document.getElementById('tipoAjuste');
        const motivo = document.getElementById('motivo');
        function filtrarMotivos() {
            if (!tipoAjuste || !motivo) return;
            const movimiento = tipoAjuste.value;
            let actualVisible = motivo.selectedOptions[0] && (!motivo.selectedOptions[0].dataset.movimiento || motivo.selectedOptions[0].dataset.movimiento === movimiento);
            [...motivo.options].forEach((option, index) => {
                const visible = index === 0 || option.dataset.movimiento === movimiento;
                option.hidden = !visible;
                option.disabled = !visible;
            });
            motivo.options[0].textContent = movimiento ? '-- Seleccione motivo --' : '-- Seleccione primero el movimiento --';
            if (!movimiento || !actualVisible) motivo.value = '';
        }
        tipoAjuste?.addEventListener('change', filtrarMotivos);
        filtrarMotivos();
        const input = document.getElementById('imagenArchivo');
        const preview = document.getElementById('previewImagenNueva');
        const img = document.getElementById('imgPreviewProducto');
        const nombre = document.getElementById('nombreImagenSeleccionada');
        const eliminar = document.getElementById('eliminarImagen');

        input?.addEventListener('change', () => {
            const archivo = input.files && input.files[0];
            if (!archivo) return;

            if (!archivo.type.startsWith('image/')) {
                input.value = '';
                preview?.classList.add('d-none');
                nombre?.classList.add('d-none');
                return;
            }

            if (img) img.src = URL.createObjectURL(archivo);
            preview?.classList.remove('d-none');
            if (nombre) {
                nombre.textContent = archivo.name;
                nombre.classList.remove('d-none');
            }
            if (eliminar) eliminar.checked = false;
        });

        document.getElementById('sedeStockProducto')?.addEventListener('change', (event) => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (!token) return;

            const form = document.createElement('form');
            form.method = 'post';
            form.action = '@Url.Action("Cambiar", "Sucursales")';
            form.innerHTML = `
                <input type="hidden" name="__RequestVerificationToken" value="${token}">
                <input type="hidden" name="sucursalId" value="${event.target.value}">
                <input type="hidden" name="returnUrl" value="${window.location.pathname + window.location.search}">
            `;
            document.body.appendChild(form);
            form.submit();
        });

    })();
</script>
