@page
@model Petmor.Web.Areas.Identity.Pages.Account.LoginWithRecoveryCodeModel

@{
    Layout = null;
    ViewData["Title"] = "Código de recuperación";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperación 2FA - Petmor</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        :root { --petmor-orange: #f06800; }
        body { min-height: 100vh; display: grid; place-items: center; margin: 0; padding: 24px; background: #f8fafc; font-family: 'Outfit', sans-serif; }
        .auth-card { width: 100%; max-width: 430px; padding: 34px; border: 1px solid #e2e8f0; border-radius: 18px; background: #fff; box-shadow: 0 20px 45px rgba(15,23,42,.12); }
        .form-control { min-height: 48px; border-radius: 12px; font-family: monospace; }
        .btn-primary { min-height: 48px; border-color: var(--petmor-orange); background: var(--petmor-orange); font-weight: 700; }
        .btn-primary:hover { border-color: #c65300; background: #c65300; }
        a:focus-visible, button:focus-visible, input:focus-visible { outline: 3px solid #9a3412; outline-offset: 3px; }
    </style>
</head>
<body>
    <main class="auth-card">
        <h1 class="h3 fw-bold mb-2">Código de recuperación</h1>
        <p class="text-muted mb-4">Usa uno de los códigos de un solo uso que guardaste al activar Authy.</p>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.RecoveryCode" class="form-label fw-semibold">Código de recuperación</label>
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="one-time-code" autofocus />
                <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Verificar e ingresar</button>
        </form>
        <div class="text-center mt-3">
            <a asp-page="./LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl" class="small">Volver al código Authy</a>
        </div>
    </main>
</body>
</html>
