            border: 1px solid #737373 !important;
        }

        body.contraste-oscuro .quick-chip.active,
        body.contraste-oscuro .quick-chip:hover,
        body.contraste-oscuro .btn-primary,
        body.contraste-oscuro .btn-pred-primary,
        body.contraste-oscuro .btn-kardex-primary,
        body.contraste-oscuro .btn-usuarios-primary,
        body.contraste-oscuro .btn-config-primary,
        body.contraste-oscuro .btn-form-primary,
        body.contraste-oscuro .date-filter-apply {
            background-color: #f06800 !important;
            border-color: #f06800 !important;
            color: #ffffff !important;
        }

        /* Adaptar botón de accesibilidad en modo oscuro */
        body.contraste-oscuro #accessibility-toggle-btn {
            background-color: #f06800 !important;
            border-color: #ffffff !important;
            color: #ffffff !important;
        }

        body.contraste-suave {
            filter: grayscale(100%) contrast(120%);
            background-color: #ffffff !important;
        }

        /* Borde y tono gris plomo (igual al icono de perfil) para el botón de accesibilidad en modo suave */
        body.contraste-suave #accessibility-toggle-btn {
            background-color: #ffffff !important;
            border: 1px solid #666666 !important;
            color: #555555 !important;
        }

        body.dislexia-amigable {
            font-family: 'Comic Sans MS', 'Comic Sans', cursive, sans-serif !important;
            letter-spacing: 1px;
        }
        
        /* --- ESTILOS DEL CURSOR ANIMADO (ADAPTABLE A TEMAS) --- */
        .custom-cursor-dot {
            position: fixed;
            width: 14px;
            height: 14px;
            background-color: #f06800;
            border-radius: 50%;
            pointer-events: none;
            z-index: 99999;
            transform: translate(-50%, -50%);
            transition: transform 0.1s ease, background-color 0.3s ease;
        }

        .custom-cursor-halo {
            position: fixed;
            width: 65px;
            height: 65px;
            border: 2.5px solid rgba(37, 99, 235, 0.5);
            background-color: rgba(37, 99, 235, 0.12);
            border-radius: 50%;
            pointer-events: none;
            z-index: 99998;
            transform: translate(-50%, -50%);
            animation: heartbeat-halo 1.5s infinite ease-in-out;
            transition: border-color 0.3s ease, background-color 0.3s ease;
        }

        /* Cambio de color automático del cursor en Modo Oscuro (Ámbar/Dorado) */
        body.contraste-oscuro .custom-cursor-dot {
            background-color: #fcd34d !important;
        }
        body.contraste-oscuro .custom-cursor-halo {
            border-color: rgba(252, 211, 77, 0.6) !important;
            background-color: rgba(252, 211, 77, 0.15) !important;
        }

        @@keyframes heartbeat-halo {
            0% {
                transform: translate(-50%, -50%) scale(0.9);
                opacity: 0.8;
            }
            50% {
                transform: translate(-50%, -50%) scale(1.35);
                opacity: 0.25;
            }
            100% {
                transform: translate(-50%, -50%) scale(0.9);
                opacity: 0.8;
            }
        }

        /* --- ESTILOS OSCUROS PARA EL MENÚ FLOTANTE DE ACCESIBILIDAD --- */
        body.contraste-oscuro #accessibility-panel {
            background-color: #12100e !important;
            border-color: #78350f !important;
        }
        body.contraste-oscuro #accessibility-panel div[style*="background: #f8fafc"],
        body.contraste-oscuro #accessibility-panel div[style*="background:#f8fafc"] {
            background-color: #12100e !important;
        }
        body.contraste-oscuro #accessibility-panel div[onclick*="ciclar"],
        body.contraste-oscuro #accessibility-panel div[onclick*="toggle"],
        body.contraste-oscuro #accessibility-panel div[onclick*="restablecer"] {
            background-color: #1c1917 !important;
            border-color: #78350f !important;
            color: #fcd34d !important;
        }
        body.contraste-oscuro #accessibility-panel div[onclick*="ciclar"] div,
        body.contraste-oscuro #accessibility-panel div[onclick*="toggle"] div {
            color: #fcd34d !important;
        }
    </style>
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/petmor-tables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/petmor-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contrast.css" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()
    
    <div class="d-flex" id="wrapper">
        
        <div class="sidebar border-end offcanvas-lg offcanvas-start" id="sidebar-wrapper" tabindex="-1" aria-label="Navegación principal">
            <div class="d-flex justify-content-between align-items-center p-3 d-lg-none">
                <span></span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebar-wrapper" aria-label="Cerrar menú"></button>
            </div>
            <div class="logo-area mb-3 text-center">
                @if (!string.IsNullOrEmpty(logoUrl))
                {
                    <img src="@logoUrl" alt="Petmor Veterinaria y Spa" style="max-height: 80px; max-width: 90%; object-fit: contain;" />
                }
                else
                {
                    <span><i class="fas fa-shopping-basket me-2"></i> @nombreEmpresa</span>
                }
            </div>

            <div class="list-group list-group-flush px-2">
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="section-title">Principal</div>
                    <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="fas fa-tachometer-alt me-2" style="width:20px"></i> Dashboard
                    </a>
                    <div class="section-title">Recepción y atención</div>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista") || User.IsInRole("Veterinario")) {
                        <a asp-controller="Clientes" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Clientes" || ViewContext.RouteData.Values["Controller"]?.ToString() == "Petmor" && new[] { "Mascotas", "Mascota", "FichaMascota" }.Contains(ViewContext.RouteData.Values["Action"]?.ToString()) ? "active" : "")"><i class="fas fa-users me-2"></i> Clientes y Mascotas</a>
                    }
                    <a asp-controller="Petmor" asp-action="Agenda" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Petmor" && new[] { "Agenda", "Agendar" }.Contains(ViewContext.RouteData.Values["Action"]?.ToString()) ? "active" : "")"><i class="fas fa-calendar-check me-2"></i> Agenda y Atenciones</a>
                    <a asp-controller="Petmor" asp-action="Servicios"><i class="fas fa-list me-2"></i> Servicios y tarifas</a>
                    <a asp-controller="Petmor" asp-action="Cuentas"><i class="fas fa-receipt me-2"></i> Cuentas pendientes</a>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista")) {
                    <div class="section-title">Caja y ventas</div>
                    <a asp-controller="Caja" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Caja" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="fas fa-cash-register me-2" style="width:20px"></i> Caja / Turno
                    </a>
                    <a asp-controller="Ventas" asp-action="Create" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ventas" && ViewContext.RouteData.Values["Action"]?.ToString() == "Create" ? "active" : "") text-info fw-bold">
                        <i class="fas fa-cart-shopping me-2" style="width:20px"></i> PUNTO DE VENTA
                    </a>
                    }

                    @if (User.IsInRole("Recepcionista") && !User.IsInRole("Administrador"))
                    {
                        <div class="section-title text-success">Ventas</div>
                        <a asp-controller="Ventas" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ventas" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                            <i class="fas fa-history me-2" style="width:20px"></i> Historial Ventas
                        </a>
                        <a asp-controller="Caja" asp-action="Historial" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Caja" && ViewContext.RouteData.Values["Action"]?.ToString() == "Historial" ? "active" : "")">
                            <i class="fas fa-cash-register me-2" style="width:20px"></i> Historial Caja
                        </a>
                    }

                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-controller="Petmor" asp-action="Reporte"><i class="fas fa-chart-line me-2"></i> Reporte de atenciones</a>
                        <div class="section-title text-success">Ventas</div>
                        <a asp-controller="Ventas" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ventas" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                            <i class="fas fa-history me-2" style="width:20px"></i> Historial Ventas
                        </a>
                        <a asp-controller="Gastos" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Gastos" ? "active" : "")">
                            <i class="fas fa-hand-holding-usd me-2" style="width:20px"></i> Control de Gastos
                        </a>
                        <a asp-controller="Caja" asp-action="Historial" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Caja" && ViewContext.RouteData.Values["Action"]?.ToString() == "Historial" ? "active" : "")">
                            <i class="fas fa-cash-register me-2" style="width:20px"></i> Historial Caja
                        </a>
                        <a asp-controller="Reportes" asp-action="Ventas" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reportes" ? "active" : "") text-info fw-bold">
                            <i class="fas fa-chart-pie me-2" style="width:20px"></i> Reportes Financieros
                        </a>

                        <div class="section-title text-primary">Inventario</div>
                        <a asp-controller="Productos" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Productos" ? "active" : "")">
                            <i class="fas fa-boxes me-2" style="width:20px"></i> Productos
                        </a>
                        <a asp-controller="Categorias" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categorias" ? "active" : "")">
                            <i class="fas fa-tags me-2" style="width:20px"></i> Categorías
                        </a>
                        <a asp-controller="Prediccion" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Prediccion" ? "active" : "")">
                            <i class="fas fa-chart-line me-2" style="width:20px"></i> Predicción de Stock
                        </a>
                        <a asp-controller="Proveedores" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Proveedores" ? "active" : "")">
                            <i class="fas fa-truck me-2" style="width:20px"></i> Proveedores
                        </a>

                        <div class="section-title text-danger">Mantenimiento</div>
                        <a asp-controller="Usuarios" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Usuarios" ? "active" : "")">
                            <i class="fas fa-user-shield me-2" style="width:20px"></i> Usuarios
                        </a>
                        <a asp-controller="Configuracion" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Configuracion" ? "active" : "")">
                            <i class="fas fa-cogs me-2" style="width:20px"></i> Configuración
                        </a>
                    }
                }
            </div>
        </div>

        <div class="main-content">
            <div class="navbar-top d-flex justify-content-end align-items-center">
                <partial name="_SelectorSede" />
                <button type="button" class="btn btn-outline-primary d-lg-none me-auto" data-bs-toggle="offcanvas" data-bs-target="#sidebar-wrapper" aria-controls="sidebar-wrapper" aria-label="Abrir menú principal">
                    <i class="fas fa-bars" aria-hidden="true"></i> <span class="ms-1">Menú</span>
                </button>

                <!-- BOTÓN DE ACCESIBILIDAD CON ANIMACIÓN -->
                <div style="position: relative; margin-right: 20px;" class="me-3">
                    <button id="accessibility-toggle-btn" class="btn btn-light border rounded-circle shadow-sm" style="width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; background-color: #fff7f0; color: #f06800;" title="Menú de Accesibilidad">
                        <i class="fas fa-universal-access" style="font-size: 28px;"></i>
                    </button>

                    <!-- MODAL / PANEL DE ACCESIBILIDAD DE 4 TARJETAS -->
                    <div id="accessibility-panel" style="display: none; position: absolute; right: 0; top: 55px; width: 380px; background: white; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); overflow: hidden; border: 1px solid #e2e8f0; z-index: 9999; font-family: inherit;">
                        <div style="background-color: #f06800; color: white; padding: 14px 18px; font-weight: 600; display: flex; justify-content: space-between; align-items: center;">
                            <span><i class="fas fa-universal-access me-2"></i> Menú de accesibilidad</span>
                            <button id="accessibility-close-btn" style="background: none; border: none; color: white; font-size: 20px; cursor: pointer;">&times;</button>
                        </div>
                        <div style="padding: 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; background: #f8fafc;">
                            <!-- Tarjeta 1: Tamaño de texto -->
                            <div onclick="ciclarTamanioTexto()" style="background: white; border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px; text-align: center; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.borderColor='#f06800'" onmouseout="this.style.borderColor='#cbd5e1'">
                                <i class="fas fa-text-height fa-lg text-primary mb-1"></i>
                                <div style="font-size: 13px; font-weight: 600; color: #1e293b; margin-bottom: 6px;">Tamaño de texto</div>
                                <div style="display: flex; justify-content: center; gap: 3px;" id="barras-texto">
                                    <span class="bar-t" style="width: 12px; height: 4px; background: #334155; border-radius: 2px;"></span>
                                    <span class="bar-t" style="width: 12px; height: 4px; background: #cbd5e1; border-radius: 2px;"></span>
                                    <span class="bar-t" style="width: 12px; height: 4px; background: #cbd5e1; border-radius: 2px;"></span>
                                    <span class="bar-t" style="width: 12px; height: 4px; background: #cbd5e1; border-radius: 2px;"></span>
                                </div>
                            </div>

                            <!-- Tarjeta 2: Contrastes -->
                            <div role="button" tabindex="0" aria-label="Cambiar contraste" onclick="toggleAltoContraste()" onkeydown="if(event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleAltoContraste(); }" style="background: white; border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px; text-align: center; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.borderColor='#f06800'" onmouseout="this.style.borderColor='#cbd5e1'">
                                <i class="fas fa-adjust fa-lg text-primary mb-1"></i>
                                <div id="contrast-label" aria-live="polite" style="font-size: 13px; font-weight: 600; color: #1e293b; margin-bottom: 6px;">Contraste: normal</div>
                                <div style="display: flex; justify-content: center; gap: 3px;">
                                    <span class="bar-c" style="width: 12px; height: 4px; background: #334155; border-radius: 2px;"></span>
                                    <span class="bar-c" style="width: 12px; height: 4px; background: #cbd5e1; border-radius: 2px;"></span>
                                    <span class="bar-c" style="width: 12px; height: 4px; background: #cbd5e1; border-radius: 2px;"></span>
                                </div>
                            </div>

                            <!-- Tarjeta 3: Cursor grande -->
                            <div onclick="toggleCursorGrande()" style="background: white; border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px; text-align: center; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.borderColor='#f06800'" onmouseout="this.style.borderColor='#cbd5e1'">
                                <i class="fas fa-mouse-pointer fa-lg text-primary mb-1"></i>
                                <div style="font-size: 13px; font-weight: 600; color: #1e293b; margin-bottom: 6px;">Cursor</div>
                                <div style="display: flex; justify-content: center; gap: 4px;">
                                    <span class="bar-u" style="width: 28px; height: 4px; background: #334155; border-radius: 2px;"></span>
                                    <span class="bar-u" style="width: 28px; height: 4px; background: #cbd5e1; border-radius: 2px;"></span>
                                </div>
                            </div>

                            <!-- Tarjeta 4: Dislexia amigable -->
                            <div onclick="toggleDislexia()" style="background: white; border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px; text-align: center; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.borderColor='#f06800'" onmouseout="this.style.borderColor='#cbd5e1'">
                                <i class="fas fa-font fa-lg text-primary mb-1"></i>
                                <div style="font-size: 13px; font-weight: 600; color: #1e293b; margin-bottom: 6px;">Dislexia amigable</div>
                                <div style="display: flex; justify-content: center; gap: 4px;">
                                    <span class="bar-d" style="width: 28px; height: 4px; background: #334155; border-radius: 2px;"></span>
                                    <span class="bar-d" style="width: 28px; height: 4px; background: #cbd5e1; border-radius: 2px;"></span>
                                </div>
                            </div>

                        </div>

                        <!-- BOTÓN INFERIOR DE RESTABLECER VALORES -->
                        <div style="padding: 0 16px 16px 16px; background: #f8fafc;">
                            <div onclick="restablecerAccesibilidad()" style="background: #ffeeec; border: 1px solid #fca5a5; border-radius: 10px; padding: 10px; text-align: center; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.borderColor='#dc2626'" onmouseout="this.style.borderColor='#fca5a5'">
                                <i class="fas fa-undo text-danger me-2"></i>
                                <span style="font-size: 13px; font-weight: 600; color: #991b1b;">Restablecer valores</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- PERFIL DE USUARIO -->
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark" id="userMenu" data-bs-toggle="dropdown" aria-label="Menú de usuario">
                            <i class="fas fa-user fa-2x me-2" style="color: var(--brand-primary);"></i>
                            <div class="d-none d-md-block line-height-normal text-start">
                                <div class="fw-bold">@User.Identity.Name</div>
                                @if (User.IsInRole("Administrador")) { <small class="fw-bold" style="font-size:0.7em; color: var(--brand-primary);">ADMINISTRADOR</small> }
                                else { <small class="fw-bold text-primary" style="font-size:0.7em">@string.Join(" · ", new[] { "Recepcionista", "Veterinario", "Groomer" }.Where(User.IsInRole))</small> }
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 animated fadeIn">
                            <li>
                                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2"></i> Cerrar Sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                     <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Iniciar Sesión</a>
                }
            </div>

            @if (!conservarDiseno)
            {
                <link rel="stylesheet" href="~/css/petmor-admin.css" asp-append-version="true" />
            }
            <div class="container-fluid p-0 @(conservarDiseno ? "" : "petmor-admin") @(formularioVisual && !conservarDiseno ? "petmor-form-page" : "")">
                @RenderBody()
            </div>
            
            <footer class="mt-5 text-center text-muted small py-3">
                © 2026 - Petmor - Veterinaria &amp; Spa
                <div>Fechas y horas de Perú (UTC−5).</div>
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.11/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/motivos.js" asp-append-version="true"></script>
    @{
        var alertaTitulo = TempData["Titulo"] as string;
        var alertaTexto = TempData["Mensaje"] as string;
        var alertaTipo = TempData["Tipo"] as string;
        var alertaExito = TempData["Exito"] as string ?? TempData["MensajeExito"] as string;
        var alertaError = TempData["Error"] as string ?? TempData["MensajeError"] as string ?? TempData["ErrorCaja"] as string;
        var erroresModelo = ViewData.ModelState.Values
            .SelectMany(v => v.Errors)
            .Select(e => e.ErrorMessage)
            .Where(e => !string.IsNullOrWhiteSpace(e))
            .Distinct()
            .ToList();
        if (!string.IsNullOrWhiteSpace(alertaError))
        {
            alertaTitulo = "Error";
            alertaTexto = alertaError;
            alertaTipo = "error";
        }
        else if (erroresModelo.Any())
        {
            alertaTitulo = "Revisa el formulario";
            alertaTipo = "warning";
        }
        else if (!string.IsNullOrWhiteSpace(alertaExito))
        {
            alertaTitulo ??= "Operación exitosa";
            alertaTexto ??= alertaExito;
            alertaTipo ??= "success";
        }
    }
    @if (!string.IsNullOrWhiteSpace(alertaTexto) || erroresModelo.Any())
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const erroresModelo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(erroresModelo));
                const normalizarMensaje = (texto) => {
                    texto = String(texto || '').replace(/\s+/g, ' ').trim();
                    const requerido = texto.match(/^The (.+) field is required\.$/i);
                    if (!requerido) return texto;
                    const mapa = {
                        MascotaId: 'Mascota',
                        ServicioId: 'Servicio / tarifa',
                        ResponsableId: 'Profesional responsable',
                        Nombre: 'Nombre',
                        Documento: 'DNI / RUC',
                        Password: 'Contraseña',
                        Rol: 'Rol'
                    };
                    return `Completa: ${mapa[requerido[1]] || requerido[1]}.`;
                };
                const htmlErrores = erroresModelo.length
                    ? `<div style="text-align:center">${erroresModelo.map(e => `<div>${PetmorImportes.texto(normalizarMensaje(e))}</div>`).join('')}</div>`
                    : null;
                Swal.fire({
                    title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(alertaTitulo ?? "Aviso")),
                    text: htmlErrores ? undefined : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(alertaTexto)),
                    html: htmlErrores || undefined,
                    icon: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(alertaTipo ?? "info")),
                    confirmButtonColor: '#f06800'
                });
            });
        </script>
    }
    <script src="https://cdn.datatables.net/1.13.11/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/petmor-tables.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
