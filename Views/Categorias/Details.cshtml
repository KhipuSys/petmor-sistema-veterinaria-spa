@model Petmor.Web.Models.Categoria

@{
    ViewData["Title"] = "Detalle de categoría";
}

<header class="pm-heading"><h2><i class="fas fa-tags me-3"></i>Detalle de categoría</h2></header>

<div class="card p-4">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Estado)
        </dd>
    </dl>
</div>
<div class="pm-actions">
    <a class="btn btn-outline-primary" asp-action="Index">Volver</a>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.Id">Editar categoría</a>
</div>
