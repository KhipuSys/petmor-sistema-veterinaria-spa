@model IEnumerable<Petmor.Web.Models.Gasto>

@{
    ViewData["Title"] = "Control de Gastos";
    var gastos = Model.ToList();
    var total = gastos.Sum(g => g.Monto);
    var hoy = HoraPeru.Hoy;
    var totalHoy = gastos.Where(g => g.Fecha.Date == hoy).Sum(g => g.Monto);
    var mayor = gastos.Any() ? gastos.Max(g => g.Monto) : 0m;
    var responsables = gastos.Select(g => g.Usuario?.UserName ?? "Sistema").Distinct().Count();
}

<section class="gastos-metrics">
    <article class="metric-card metric-count"><div class="metric-icon"><i class="fas fa-file-invoice-dollar"></i></div><div><span>Gastos</span><strong>@gastos.Count</strong><small>Registros encontrados</small></div></article>
    <article class="metric-card metric-total"><div class="metric-icon"><i class="fas fa-coins"></i></div><div><span>Total</span><strong>S/. @total.ToString("N2")</strong><small>Salidas acumuladas</small></div></article>
    <article class="metric-card metric-today"><div class="metric-icon"><i class="fas fa-calendar-check"></i></div><div><span>Hoy</span><strong>S/. @totalHoy.ToString("N2")</strong><small>Movimientos del día</small></div></article>
    <article class="metric-card metric-users"><div class="metric-icon"><i class="fas fa-users"></i></div><div><span>Responsables</span><strong>@responsables</strong><small>Usuarios con gastos</small></div></article>
</section>

<section class="gastos-card">
    <div class="gastos-head">
        <div class="gastos-title"><div class="gastos-icon"><i class="fas fa-hand-holding-usd"></i></div><div><h2>Control de Gastos</h2><p>Registro auditado de salidas de caja y gastos operativos</p></div></div>
        <a asp-action="Create" class="btn btn-gastos-primary"><i class="fas fa-plus me-2"></i>Registrar gasto</a>
    </div>

    <div class="gastos-date-row">
        @{ ViewData["DateFilterController"] = "Gastos"; ViewData["DateFilterAction"] = "Index"; ViewData["DateFilterMode"] = "range"; ViewData["DateFilterFrom"] = ViewBag.Desde; ViewData["DateFilterTo"] = ViewBag.Hasta; ViewData["DateFilterClearLabel"] = "Limpiar"; }
        <partial name="_DateFilter" />
    </div>

    <div class="gastos-tools">
        <span>Filtros rápidos:</span>
        <button type="button" class="quick-chip active" data-filter="todos"><i class="fas fa-list"></i>Todos</button>
        <button type="button" class="quick-chip" data-filter="hoy"><i class="fas fa-calendar-check"></i>Hoy</button>
        <button type="button" class="quick-chip" data-filter="alto"><i class="fas fa-arrow-trend-up"></i>Mayor a promedio</button>
        <div class="export-actions">
            <button type="button" class="export-btn" id="btnExportExcel"><i class="fas fa-file-excel"></i>Excel</button>
            <button type="button" class="export-btn" id="btnExportPdf"><i class="fas fa-file-pdf"></i>PDF</button>
            <button type="button" class="export-btn" id="btnExportPrint"><i class="fas fa-print"></i>Imprimir</button>
        </div>
    </div>

    <div class="table-responsive gastos-table-wrap">
        <table class="table gastos-table align-middle" id="tablaGastos">
            <thead><tr><th>ID</th><th>Fecha</th><th>Concepto</th><th>Responsable</th><th>Caja</th><th class="text-end">Monto</th></tr></thead>
            <tbody>
            @foreach (var item in gastos)
            {
                var responsable = item.Usuario?.UserName ?? "Sistema";
                var esHoy = item.Fecha.Date == hoy ? "true" : "false";
                var esAlto = total > 0 && item.Monto > (total / gastos.Count) ? "true" : "false";
                <tr data-hoy="@esHoy" data-alto="@esAlto">
                    <td><strong>#@item.Id.ToString("D5")</strong></td>
                    <td><strong>@item.Fecha.ToString("dd/MM/yyyy")</strong><small>@item.Fecha.ToString("HH:mm")</small></td>
                    <td><strong>@item.Concepto</strong><small>Gasto operativo</small></td>
                    <td><span class="user-pill"><i class="fas fa-user"></i>@responsable.Split('@')[0]</span></td>
                    <td>@if (item.AperturaCajaId.HasValue) { <span class="cash-pill"><i class="fas fa-cash-register"></i>Caja #@item.AperturaCajaId</span> } else { <span class="cash-pill muted"><i class="fas fa-minus-circle"></i>Sin caja</span> }</td>
                    <td class="text-end"><strong class="money-text">S/. @item.Monto.ToString("N2")</strong></td>
                </tr>
            }
            </tbody>
            <tfoot><tr><th colspan="5" class="text-end">Total gastos</th><th class="text-end">S/. @total.ToString("N2")</th></tr></tfoot>
        </table>
    </div>
    @if (!gastos.Any())
    {
        <div class="gastos-empty"><i class="fas fa-file-invoice-dollar"></i><h3>Sin gastos registrados</h3><p>Cuando registres salidas de caja, aparecerán aquí.</p><a asp-action="Create" class="btn btn-gastos-primary">Registrar gasto</a></div>
    }
</section>

<style>
    .gastos-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-bottom: 22px; }
    .metric-card { min-height: 112px; display: flex; align-items: center; gap: 16px; padding: 20px; border: 1px solid #e5e7eb; border-radius: 14px; background: linear-gradient(135deg, #fff, #fbfdff); }
    .metric-icon { width: 58px; height: 58px; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 25px; flex: 0 0 auto; }
    .metric-card span { color: #64748b; font-weight: 900; font-size: .82rem; text-transform: uppercase; letter-spacing: .05em; }
    .metric-card strong { display: block; margin-top: 2px; color: #0f172a; font-size: 1.55rem; line-height: 1; font-weight: 900; }
    .metric-card small { display: block; margin-top: 8px; color: #64748b; font-weight: 600; }
    .metric-count .metric-icon { background: #fff3ea; color: #f06800; } .metric-total .metric-icon { background: #fee2e2; color: #dc2626; } .metric-today .metric-icon { background: #eff6ff; color: #2563eb; } .metric-users .metric-icon { background: #ecfdf5; color: #059669; }
    .gastos-card { border: 1px solid #e5e7eb; border-radius: 14px; background: #fff; overflow: hidden; }
    .gastos-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; border-bottom: 1px solid #e5e7eb; background: linear-gradient(135deg, #fff, #f8fafc); }
    .gastos-title { display: flex; align-items: center; gap: 12px; } .gastos-icon { width: 42px; height: 42px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; background: #fff3ea; color: #f06800; }
    .gastos-title h2 { margin: 0; color: #0f172a; font-size: 1.1rem; font-weight: 900; } .gastos-title p { margin: 3px 0 0; color: #64748b; font-size: .92rem; }
    .btn-gastos-primary { min-height: 46px; border-radius: 10px; padding: 11px 18px; background: #f06800; border: 1px solid #f06800; color: #fff !important; font-weight: 900; } .btn-gastos-primary:hover { background: #d95f00; color: #fff !important; }
    .gastos-date-row { padding: 14px 20px 0; }
    .gastos-tools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 14px 20px 0; color: #475569; font-weight: 900; font-size: .86rem; }
    .quick-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 34px; padding: 6px 12px; border-radius: 999px; border: 1px solid #fed7aa; background: #fff; color: #f06800; font-size: .82rem; font-weight: 900; }
    .quick-chip.active, .quick-chip:hover { background: #f06800; color: #fff; border-color: #f06800; }
    .export-actions { display: inline-flex; gap: 8px; flex-wrap: wrap; margin-left: auto; }
    .export-btn { min-height: 34px; display: inline-flex; align-items: center; gap: 6px; border-radius: 9px; border: 1px solid #fed7aa; background: #fff; color: #f06800; padding: 6px 12px; font-size: .82rem; font-weight: 900; }
    .export-btn:hover { background: #fff7ed; color: #c2410c; }
    .gastos-table-wrap { margin: 18px; border: 1px solid #e5e7eb; border-radius: 12px; }
    .gastos-table { margin: 0; min-width: 980px; }
    .gastos-table thead th, .gastos-table tfoot th { background: #f8fafc !important; color: #0f172a; font-weight: 900; padding: 16px 18px; border-bottom: 1px solid #e2e8f0; font-size: .88rem; }
    .gastos-table tbody td { padding: 18px; border-bottom: 1px solid #e2e8f0; color: #334155; vertical-align: middle; }
    .gastos-table tbody tr:last-child td { border-bottom: 0; } .gastos-table strong { display: block; color: #0f172a; font-weight: 900; } .gastos-table small { display: block; color: #64748b; margin-top: 3px; }
    .user-pill, .cash-pill { display: inline-flex; align-items: center; gap: 7px; border-radius: 999px; padding: 8px 13px; background: #f1f5f9; color: #334155; font-weight: 900; font-size: .8rem; }
    .cash-pill { background: #fff7ed; color: #f06800; } .cash-pill.muted { background: #f1f5f9; color: #64748b; }
    .money-text { color: #dc2626 !important; font-size: 1.04rem; }
    .gastos-empty { display: grid; place-items: center; padding: 44px 16px; text-align: center; color: #64748b; }
    .gastos-empty i { width: 58px; height: 58px; display: inline-flex; align-items: center; justify-content: center; border-radius: 16px; background: #fff3ea; color: #f06800; font-size: 26px; margin-bottom: 12px; }
    .gastos-empty h3 { color: #0f172a; font-size: 1.2rem; font-weight: 900; margin: 0; }
    .gastos-empty p { margin: 6px 0 14px; }
    .dataTables_wrapper { padding: 0 18px 18px; } .dataTables_wrapper .dt-buttons .btn { border-radius: 9px; font-weight: 900; margin-right: 6px; border: 1px solid #fed7aa !important; background: #fff !important; color: #f06800 !important; } .dataTables_wrapper .dt-buttons .btn:hover { background: #fff7ed !important; color: #c2410c !important; } .dataTables_filter input, .dataTables_length select { border: 1px solid #dbe3ee; border-radius: 9px; padding: 6px 10px; }
    @@media (max-width: 1199.98px) { .gastos-metrics { grid-template-columns: 1fr 1fr; } }
    @@media (max-width: 767.98px) { .gastos-metrics { grid-template-columns: 1fr; } .gastos-head { align-items: flex-start; flex-direction: column; } .btn-gastos-primary { width: 100%; } .export-actions { margin-left: 0; width: 100%; } }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable.isDataTable('#tablaGastos')) $('#tablaGastos').DataTable().destroy();
            let filtroRapido = 'todos';
            $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
                if (settings.nTable.id !== 'tablaGastos' || filtroRapido === 'todos') return true;
                const row = settings.aoData[dataIndex].nTr;
                if (!row) return true;
                return row.dataset[filtroRapido] === 'true';
            });
            const tabla = $('#tablaGastos').DataTable({
                dom: PetmorTables.dom,
                buttons: PetmorTables.exportButtons('Historial de gastos'),
                order: [[0, 'desc']],
            });
            $('.quick-chip').on('click', function() {
                $('.quick-chip').removeClass('active');
                $(this).addClass('active');
                filtroRapido = $(this).data('filter');
                tabla.draw();
            });
            $('#btnExportExcel').on('click', () => tabla.button('.buttons-excel').trigger());
            $('#btnExportPdf').on('click', () => tabla.button('.buttons-pdf').trigger());
            $('#btnExportPrint').on('click', () => tabla.button('.buttons-print').trigger());
        });
    </script>
}
