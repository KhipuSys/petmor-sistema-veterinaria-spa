@using Microsoft.AspNetCore.Identity
@using MiniMarket.Web.Data
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject ApplicationDbContext _context

@{
    var globalConfig = _context.Configuraciones.FirstOrDefault();
    var logoUrl = Url.Content("~/petmor-logo-blanco.png");
    var nombreEmpresa = "Petmor · Veterinaria & Spa";
    var controladorVisual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accionVisual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var conservarDiseno = controladorVisual == "Clientes" ||
        (controladorVisual == "Petmor" && new[] { "Mascotas", "Mascota", "FichaMascota" }.Contains(accionVisual));
    var formularioVisual = new[] { "Create", "Edit", "Agendar", "Servicio", "Ajuste" }.Contains(accionVisual);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Petmor - @ViewData["Title"]</title>
    <script src="~/js/importes.js" asp-append-version="true"></script>
    <link rel="icon" type="image/png" href="~/petmor-logo-blanco.png" asp-append-version="true" />
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.11/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.bootstrap5.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --brand-primary: #f06800;
            --brand-primary-hover: #c65300;
            --brand-secondary: #f06800;
            --sidebar-bg: #f06800;
            --sidebar-hover: #f06800;
        }

        body { 
            background-color: #f8fafc; 
            font-family: 'Outfit', sans-serif; 
            overflow-x: hidden;
        }

        *,
        *::before,
        *::after {
            box-shadow: none !important;
        }

        /* --- LOGICA RESPONSIVA DEL SIDEBAR --- */
        #wrapper {
            display: flex;
            width: 100%;
            transition: all 0.3s;
        }

        .sidebar {
            min-width: 250px;
            max-width: 250px;
            background-color: var(--sidebar-bg);
            color: #fff;
            min-height: 100vh;
            transition: margin 0.3s ease-out;
            z-index: 1040;
        }

        .sidebar a { color: #fff; text-decoration: none; padding: 12px 15px; display: flex; align-items: center; border-radius: 8px; margin-bottom: 5px; margin-left: 10px; margin-right: 10px; transition: all 0.2s; font-weight: 500; }
        .sidebar a:hover { background-color: var(--sidebar-hover); color: #fff; }
        .sidebar a.active { background-color: #f06800; color: #fff; box-shadow: none; font-weight: 700; }
        .sidebar a.active:hover { color: #fff; }
        .sidebar .section-title { font-size: 0.75rem; text-transform: uppercase; color: #fff; padding: 10px 20px; font-weight: 700; letter-spacing: 1px; margin-top: 15px; border-bottom: 0; margin-bottom: 10px; }
        
        .logo-area { padding: 25px 20px; font-size: 1.5rem; font-weight: 700; color: #fff; display: flex; align-items: center; justify-content: center; background-color: #f06800; border-bottom: 0; }
        .sidebar a, .sidebar a i, .sidebar .section-title, .logo-area i { color: #fff !important; }
        .sidebar a:hover { box-shadow: none; text-decoration: underline; }
        .sidebar a:focus-visible { outline: 2px solid #fff; outline-offset: -2px; }

        .main-content {
            width: 100%;
            padding: 20px;
            transition: all 0.3s;
        }

        .navbar-top { 
            background-color: #fff; 
            padding: 12px 25px; 
            margin-bottom: 25px; 
            border-radius: 12px; 
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 20px;
        }


        .card { border: 1px solid #e5e7eb; border-radius: 18px; background: #fff; overflow: hidden; }
        .card-header {
            border-bottom: 1px solid #e5e7eb;
            background: #fff !important;
            color: #0f172a !important;
            padding: 18px 22px;
        }
        .card-header.bg-primary,
        .card-header.bg-info,
        .card-header.bg-success,
        .card-header.bg-warning,
        .card-header.bg-danger,
        .card-header.bg-dark {
            background: linear-gradient(135deg, #ff7a00 0%, #f06800 100%) !important;
            color: #fff !important;
            border-bottom: 0;
        }
        .card-header.bg-primary *,
        .card-header.bg-info *,
        .card-header.bg-success *,
        .card-header.bg-warning *,
        .card-header.bg-danger *,
        .card-header.bg-dark * { color: #fff !important; }
        .card-body { padding: 24px; }
        .btn-primary { background-color: var(--brand-primary); border-color: var(--brand-primary); color: #fff !important; }
        .btn-primary:hover, .btn-primary:focus { background-color: var(--brand-primary-hover); border-color: var(--brand-primary-hover); color: #fff !important; }
        .btn-primary i, .btn-primary span { color: #fff !important; }
        .btn { border-radius: 10px; font-weight: 800; }
        .reason-eye { width: 34px; height: 34px; display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; border: 1px solid #fecaca; border-radius: 50%; background: #fff; color: #dc2626; padding: 0; }
        .reason-eye:is(:hover,:focus,:active) { background: #fef2f2; color: #b91c1c; border-color: #fca5a5; }
        .btn-form-primary,
        .btn-config-primary {
            --bs-btn-color: #fff;
            --bs-btn-bg: #f06800;
            --bs-btn-border-color: #f06800;
            --bs-btn-hover-color: #fff;
            --bs-btn-hover-bg: #c95500;
            --bs-btn-hover-border-color: #c95500;
            --bs-btn-active-color: #fff;
            --bs-btn-active-bg: #c95500;
            --bs-btn-active-border-color: #c95500;
            --bs-btn-disabled-color: #fff;
            --bs-btn-disabled-bg: #f06800;
            --bs-btn-disabled-border-color: #f06800;
            --bs-btn-focus-shadow-rgb: 240, 104, 0;
        }
        .btn-lg { min-height: 52px; padding-left: 22px; padding-right: 22px; }
        .btn-secondary,
        .btn-light {
            background: #fff !important;
            border-color: #cbd5e1 !important;
            color: #334155 !important;
        }
        .btn-secondary:hover,
        .btn-light:hover {
            background: #f8fafc !important;
            color: #0f172a !important;
        }
        .btn-warning,
        .btn-info,
        .btn-success,
        .btn-dark {
            background: var(--brand-primary) !important;
            border-color: var(--brand-primary) !important;
            color: #fff !important;
        }
        .btn-warning:hover,
        .btn-info:hover,
        .btn-success:hover,
        .btn-dark:hover {
            background: var(--brand-primary-hover) !important;
            border-color: var(--brand-primary-hover) !important;
            color: #fff !important;
        }
        .btn-warning i,
        .btn-info i,
        .btn-success i,
        .btn-dark i { color: #fff !important; }
        .text-primary { color: var(--brand-primary) !important; }
        a, .text-info, .text-success, .text-warning { color: var(--brand-primary) !important; }
        .btn-outline-primary, .btn-outline-info, .btn-outline-success, .btn-outline-warning { color: var(--brand-primary) !important; border-color: var(--brand-primary) !important; }
        .btn-outline-primary:hover, .btn-outline-info:hover, .btn-outline-success:hover, .btn-outline-warning:hover { background-color: var(--brand-primary) !important; color: #fff !important; }
        .btn-outline-secondary {
            color: #f06800 !important;
            border-color: #f06800 !important;
            background: #fff !important;
        }
        .btn-outline-secondary:hover {
            color: #c2410c !important;
            background: #fff7ed !important;
            border-color: #f06800 !important;
        }
        .scan-box { border: 1px solid #dbe3ee; border-radius: 12px; padding: 14px; margin: 16px 0; background: #fff; }
        .scan-label { display: block; margin-bottom: 10px; color: #0f172a; font-weight: 900; }
        .scan-row { display: grid; grid-template-columns: minmax(180px, 1fr) auto auto; gap: 10px; align-items: center; }
        .scan-input { min-height: 44px; font-weight: 800; }
        .scan-btn { min-height: 44px; border-radius: 10px; padding: 10px 16px; font-weight: 900; white-space: nowrap; }
        .scan-btn-read { background: #f06800; border: 1px solid #f06800; color: #fff !important; }
        .scan-btn-read:hover { background: #d95f00; border-color: #d95f00; color: #fff !important; }
        .scan-btn-undo { background: #fff; border: 1px solid #fed7aa; color: #f06800 !important; }
        .scan-btn-undo:hover { background: #fff7ed; border-color: #f06800; color: #c2410c !important; }
        .scan-help { display: block; margin-top: 10px; color: #475569; font-weight: 600; }
        .bg-primary, .bg-info, .bg-success, .bg-warning { background-color: var(--brand-primary) !important; }
        .border-primary, .border-info, .border-success, .border-warning { border-color: var(--brand-primary) !important; }
        .page-item.active .page-link, .dataTables_wrapper .pagination .page-item.active .page-link { background-color: var(--brand-primary); border-color: var(--brand-primary); color: #fff !important; }
        .page-link { color: var(--brand-primary); }
        .form-control,
        .form-select {
            min-height: 46px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            color: #0f172a;
        }
        textarea.form-control { min-height: 92px; }
        .form-control:focus, .form-select:focus { border-color: var(--brand-primary); outline: 2px solid rgba(240,104,0,.2); outline-offset: 1px; }
        .form-label,
        label { color: #111827; font-weight: 800; }
        .required-mark {
            color: #dc2626 !important;
            font-weight: 900;
            margin-left: 4px;
        }

        .table { --bs-table-striped-bg: #fff7ed; }
        .table thead th {
            color: #0f172a;
            font-weight: 800;
            border-bottom: 1px solid #e2e8f0;
            background: #fff !important;
        }
