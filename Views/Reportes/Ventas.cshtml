@model IEnumerable<Petmor.Web.Models.ViewModels.ReporteVentasViewModel>

@{
    ViewData["Title"] = "Reporte Financiero";
    var ventas = Model.ToList();
    decimal totalIngresos = ventas.Sum(m => m.TotalVenta);
    var completos = ventas.Where(m => m.CostoTotal.HasValue).ToList();
    decimal totalCostos = completos.Sum(m => m.CostoTotal ?? 0);
    decimal gananciaNetaTotal = completos.Sum(m => m.GananciaNeta ?? 0);
    decimal ingresosConCosto = completos.Sum(m => m.TotalVenta);
    decimal margenPromedio = ingresosConCosto > 0 ? (gananciaNetaTotal / ingresosConCosto) * 100 : 0;
    var sinCosto = ventas.Count(m => !m.CostoTotal.HasValue);
}

<section class="finance-metrics">
    <article class="metric-card metric-income"><div class="metric-icon"><i class="fas fa-sack-dollar"></i></div><div><span>Ingresos</span><strong>S/. @totalIngresos.ToString("N2")</strong><small>@ventas.Count venta@(ventas.Count == 1 ? "" : "s") activa@(ventas.Count == 1 ? "" : "s")</small></div></article>
    <article class="metric-card metric-cost"><div class="metric-icon"><i class="fas fa-boxes-stacked"></i></div><div><span>Costos</span><strong>S/. @totalCostos.ToString("N2")</strong><small>Con costo histórico</small></div></article>
    <article class="metric-card metric-profit"><div class="metric-icon"><i class="fas fa-chart-line"></i></div><div><span>Utilidad</span><strong>S/. @gananciaNetaTotal.ToString("N2")</strong><small>Bruta registrada</small></div></article>
    <article class="metric-card metric-margin"><div class="metric-icon"><i class="fas fa-percent"></i></div><div><span>Margen</span><strong>@margenPromedio.ToString("N1")%</strong><small>Promedio ponderado</small></div></article>
</section>

<section class="finance-card">
    <div class="finance-head">
        <div class="finance-title"><div class="finance-icon"><i class="fas fa-file-invoice-dollar"></i></div><div><h2>Reporte Financiero</h2><p>Consolidado de ventas, costos, utilidad y márgenes</p></div></div>
        <a asp-controller="Ventas" asp-action="Index" class="btn btn-finance-primary"><i class="fas fa-receipt me-2"></i>Ver ventas</a>
    </div>

    <div class="finance-date-row">
        @{ ViewData["DateFilterController"] = "Reportes"; ViewData["DateFilterAction"] = "Ventas"; ViewData["DateFilterMode"] = "range"; ViewData["DateFilterFromName"] = "fechaInicio"; ViewData["DateFilterToName"] = "fechaFin"; ViewData["DateFilterFrom"] = ViewBag.FechaInicio; ViewData["DateFilterTo"] = ViewBag.FechaFin; ViewData["DateFilterClearLabel"] = "Últimos 30 días"; }
        <partial name="_DateFilter" />
    </div>

    @if (sinCosto > 0)
    {
        <div class="finance-note"><i class="fas fa-circle-info"></i><span>@sinCosto venta@(sinCosto == 1 ? "" : "s") sin costo histórico. Costos, utilidad y margen solo incluyen ventas con costo registrado.</span></div>
    }

    <div class="finance-tools">
        <span>Filtros rápidos:</span>
        <button type="button" class="quick-chip active" data-filter="todos"><i class="fas fa-list"></i>Todos</button>
        <button type="button" class="quick-chip" data-filter="rentable"><i class="fas fa-arrow-trend-up"></i>Rentables</button>
        <button type="button" class="quick-chip" data-filter="bajo"><i class="fas fa-triangle-exclamation"></i>Margen bajo</button>
        <button type="button" class="quick-chip" data-filter="sincosto"><i class="fas fa-circle-question"></i>Sin costo</button>
        <div class="export-actions">
            <button type="button" class="export-btn" id="btnExportExcel"><i class="fas fa-file-excel"></i>Excel</button>
            <button type="button" class="export-btn" id="btnExportPdf"><i class="fas fa-file-pdf"></i>PDF</button>
            <button type="button" class="export-btn" id="btnExportPrint"><i class="fas fa-print"></i>Imprimir</button>
        </div>
    </div>

    <div class="table-responsive finance-table-wrap">
        <table id="tblReporteVentas" class="table finance-table align-middle">
            <thead><tr><th>Ticket</th><th>Fecha</th><th>Cliente</th><th>Cajero</th><th>Método</th><th class="text-center">Cant.</th><th class="text-end">Venta</th><th class="text-end">Costo</th><th class="text-end">Utilidad</th><th>Margen</th></tr></thead>
            <tbody>
            @foreach (var item in ventas)
            {
                var metodo = item.MetodoPago ?? "Efectivo";
                var pagoClase = metodo switch { "Tarjeta" => "pay-card", "Yape" => "pay-yape", "Plin" => "pay-plin", "QR" => "pay-qr", _ => "pay-cash" };
                var iconoPago = metodo switch { "Tarjeta" => "fa-credit-card", "Yape" => "fa-mobile-alt", "Plin" => "fa-mobile-alt", "QR" => "fa-qrcode", _ => "fa-money-bill-wave" };
                var margen = item.MargenPorcentaje;
                var filtro = !item.CostoTotal.HasValue ? "sincosto" : margen >= 20 ? "rentable" : "bajo";
                var margenClase = !margen.HasValue ? "margin-na" : margen >= 20 ? "margin-good" : "margin-low";
                <tr data-rentable="@(filtro == "rentable" ? "true" : "false")" data-bajo="@(filtro == "bajo" ? "true" : "false")" data-sincosto="@(filtro == "sincosto" ? "true" : "false")">
                    <td><strong>#@item.VentaId.ToString("D5")</strong></td>
                    <td><strong>@item.Fecha.ToString("dd/MM/yyyy")</strong><small>@item.Fecha.ToString("HH:mm")</small></td>
                    <td><strong>@item.Cliente</strong><small>Cliente</small></td>
                    <td><span class="cashier-pill"><i class="fas fa-user"></i>@(item.Cajero?.Split('@')[0] ?? "Sistema")</span></td>
                    <td><span class="pay-pill @pagoClase"><i class="fas @iconoPago"></i>@metodo</span></td>
                    <td class="text-center"><span class="qty-pill">@item.CantidadArticulos</span></td>
                    <td class="text-end"><strong class="income-text">S/. @item.TotalVenta.ToString("N2")</strong></td>
                    <td class="text-end">@if (item.CostoTotal.HasValue) { <strong class="cost-text">S/. @item.CostoTotal.Value.ToString("N2")</strong> } else { <span class="na-pill">N/D</span> }</td>
                    <td class="text-end">@if (item.GananciaNeta.HasValue) { <strong class="profit-text">S/. @item.GananciaNeta.Value.ToString("N2")</strong> } else { <span class="na-pill">N/D</span> }</td>
                    <td><span class="margin-pill @margenClase"><i class="fas @(margen.HasValue ? "fa-percent" : "fa-circle-question")"></i>@(margen.HasValue ? margen.Value.ToString("N2") + "%" : "N/D")</span></td>
                </tr>
            }
            </tbody>
            <tfoot><tr><th colspan="6" class="text-end">Totales</th><th class="text-end">S/. @totalIngresos.ToString("N2")</th><th class="text-end">S/. @totalCostos.ToString("N2")</th><th class="text-end">S/. @gananciaNetaTotal.ToString("N2")</th><th>@margenPromedio.ToString("N1")%</th></tr></tfoot>
        </table>
    </div>

    @if (!ventas.Any())
    {
        <div class="finance-empty"><i class="fas fa-file-invoice-dollar"></i><h3>Sin ventas en el rango</h3><p>Ajusta las fechas para consultar movimientos financieros.</p></div>
    }
</section>

<style>
    .finance-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-bottom: 22px; }
    .metric-card { min-height: 112px; display: flex; align-items: center; gap: 16px; padding: 20px; border: 1px solid #e5e7eb; border-radius: 14px; background: linear-gradient(135deg, #fff, #fbfdff); }
    .metric-icon { width: 58px; height: 58px; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 25px; flex: 0 0 auto; }
    .metric-card span { color: #64748b; font-weight: 900; font-size: .82rem; text-transform: uppercase; letter-spacing: .05em; }
    .metric-card strong { display: block; margin-top: 2px; color: #0f172a; font-size: 1.5rem; line-height: 1; font-weight: 900; }
    .metric-card small { display: block; margin-top: 8px; color: #64748b; font-weight: 600; }
    .metric-income .metric-icon { background: #fff3ea; color: #f06800; } .metric-cost .metric-icon { background: #fee2e2; color: #dc2626; } .metric-profit .metric-icon { background: #ecfdf5; color: #059669; } .metric-margin .metric-icon { background: #eff6ff; color: #2563eb; }
    .finance-card { border: 1px solid #e5e7eb; border-radius: 14px; background: #fff; overflow: hidden; }
    .finance-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; border-bottom: 1px solid #e5e7eb; background: linear-gradient(135deg, #fff, #f8fafc); }
    .finance-title { display: flex; align-items: center; gap: 12px; } .finance-icon { width: 42px; height: 42px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; background: #fff3ea; color: #f06800; }
    .finance-title h2 { margin: 0; color: #0f172a; font-size: 1.1rem; font-weight: 900; } .finance-title p { margin: 3px 0 0; color: #64748b; font-size: .92rem; }
    .btn-finance-primary { min-height: 46px; border-radius: 10px; padding: 11px 18px; background: #f06800; border: 1px solid #f06800; color: #fff !important; font-weight: 900; } .btn-finance-primary:hover { background: #d95f00; color: #fff !important; }
    .finance-date-row { padding: 14px 20px 0; }
    .finance-note { display: flex; align-items: center; gap: 10px; margin: 14px 20px 0; padding: 12px 14px; border: 1px solid #fed7aa; border-radius: 12px; background: #fff7ed; color: #9a3412; font-weight: 800; }
    .finance-tools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 14px 20px 0; color: #475569; font-weight: 900; font-size: .86rem; }
    .quick-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 34px; padding: 6px 12px; border-radius: 999px; border: 1px solid #fed7aa; background: #fff; color: #f06800; font-size: .82rem; font-weight: 900; }
    .quick-chip.active, .quick-chip:hover { background: #f06800; color: #fff; border-color: #f06800; }
    .export-actions { display: inline-flex; gap: 8px; flex-wrap: wrap; margin-left: auto; }
    .export-btn { min-height: 34px; display: inline-flex; align-items: center; gap: 6px; border-radius: 9px; border: 1px solid #fed7aa; background: #fff; color: #f06800; padding: 6px 12px; font-size: .82rem; font-weight: 900; }
    .export-btn:hover { background: #fff7ed; color: #c2410c; }
    .finance-table-wrap { margin: 18px; border: 1px solid #e5e7eb; border-radius: 12px; }
    .finance-table { margin: 0; min-width: 1180px; }
    .finance-table thead th, .finance-table tfoot th { background: #f8fafc !important; color: #0f172a; font-weight: 900; padding: 16px 18px; border-bottom: 1px solid #e2e8f0; font-size: .88rem; }
    .finance-table tbody td { padding: 18px; border-bottom: 1px solid #e2e8f0; color: #334155; vertical-align: middle; }
    .finance-table tbody tr:last-child td { border-bottom: 0; } .finance-table strong { display: block; color: #0f172a; font-weight: 900; } .finance-table small { display: block; color: #64748b; margin-top: 3px; }
    .cashier-pill, .pay-pill, .qty-pill, .margin-pill, .na-pill { display: inline-flex; align-items: center; gap: 7px; border-radius: 999px; padding: 8px 13px; font-weight: 900; font-size: .8rem; }
    .cashier-pill, .qty-pill { background: #f1f5f9; color: #334155; } .pay-cash { background: #ecfdf5; color: #059669; } .pay-card { background: #eff6ff; color: #2563eb; } .pay-yape { background: #f0f9ff; color: #0284c7; } .pay-plin { background: #fff7ed; color: #f06800; } .pay-qr { background: #f1f5f9; color: #475569; }
    .income-text { color: #0f172a !important; } .cost-text { color: #dc2626 !important; } .profit-text { color: #059669 !important; }
    .margin-good { background: #ecfdf5; color: #059669; } .margin-low { background: #fffbeb; color: #d97706; } .margin-na, .na-pill { background: #f1f5f9; color: #64748b; }
    .finance-empty { display: grid; place-items: center; padding: 44px 16px; text-align: center; color: #64748b; }
    .finance-empty i { width: 58px; height: 58px; display: inline-flex; align-items: center; justify-content: center; border-radius: 16px; background: #fff3ea; color: #f06800; font-size: 26px; margin-bottom: 12px; }
    .finance-empty h3 { color: #0f172a; font-size: 1.2rem; font-weight: 900; margin: 0; }
    .finance-empty p { margin: 6px 0 14px; }
    .dataTables_wrapper { padding: 0 18px 18px; } .dataTables_wrapper .dt-buttons .btn { border-radius: 9px; font-weight: 900; margin-right: 6px; border: 1px solid #fed7aa !important; background: #fff !important; color: #f06800 !important; } .dataTables_wrapper .dt-buttons .btn:hover { background: #fff7ed !important; color: #c2410c !important; } .dataTables_filter input, .dataTables_length select { border: 1px solid #dbe3ee; border-radius: 9px; padding: 6px 10px; }
    @@media (max-width: 1199.98px) { .finance-metrics { grid-template-columns: 1fr 1fr; } }
    @@media (max-width: 767.98px) { .finance-metrics { grid-template-columns: 1fr; } .finance-head { align-items: flex-start; flex-direction: column; } .btn-finance-primary { width: 100%; } .export-actions { margin-left: 0; width: 100%; } }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable.isDataTable('#tblReporteVentas')) $('#tblReporteVentas').DataTable().destroy();
            let filtroRapido = 'todos';
            $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
                if (settings.nTable.id !== 'tblReporteVentas' || filtroRapido === 'todos') return true;
                const row = settings.aoData[dataIndex].nTr;
                if (!row) return true;
                return row.dataset[filtroRapido] === 'true';
            });
            const tabla = $('#tblReporteVentas').DataTable({
                dom: PetmorTables.dom,
                buttons: PetmorTables.exportButtons('Reporte financiero Petmor'),
                order: [[0, 'desc']],
                pageLength: 10,
            });
            $('.quick-chip').on('click', function() {
                $('.quick-chip').removeClass('active');
                $(this).addClass('active');
                filtroRapido = $(this).data('filter');
                tabla.draw();
            });
            $('#btnExportExcel').on('click', () => tabla.button('.buttons-excel').trigger());
            $('#btnExportPdf').on('click', () => tabla.button('.buttons-pdf').trigger());
            $('#btnExportPrint').on('click', () => tabla.button('.buttons-print').trigger());
        });
    </script>
}
